<h3 class="fw-bold mb-4">Place a New Order</h3>

<div class="row justify-content-center">
  <div class="col-md-7">
    <div class="card shadow-sm border-0">
      <div class="card-body p-4">

        <div id="orderAlert" class="alert d-none"></div>

        <form id="newOrderForm">
          <div class="mb-3">
            <label class="form-label">Category</label>
            <select id="categorySelect" class="form-select">
              <option value="">All Categories</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label">Service</label>
            <select id="serviceSelect" name="serviceId" class="form-select" required>
              <option value="">Select a service...</option>
              <% services.forEach(s => { %>
                <option
                  value="<%= s._id %>"
                  data-category="<%= s.category %>"
                  data-rate="<%= s.sellPricePer1000 %>"
                  data-min="<%= s.minOrder %>"
                  data-max="<%= s.maxOrder %>">
                  <%= s.category %> - <%= s.name %> (<%= settings.currency %> <%= s.sellPricePer1000.toFixed(2) %>/1000)
                </option>
              <% }) %>
            </select>
            <div class="form-text" id="serviceMeta"></div>
          </div>

          <div class="mb-3">
            <label class="form-label">Link</label>
            <input type="url" id="linkInput" name="link" class="form-control" placeholder="https://instagram.com/..." required>
          </div>

          <div class="mb-3">
            <label class="form-label">Quantity</label>
            <input type="number" id="quantityInput" name="quantity" class="form-control" required>
            <div class="form-text" id="quantityHint">Select a service to see min/max.</div>
          </div>

          <div class="alert alert-light border d-flex justify-content-between align-items-center">
            <span>Total Charge</span>
            <span class="fs-5 fw-bold text-success" id="totalCharge"><%= settings.currency %> 0.00</span>
          </div>

          <button type="submit" class="btn btn-primary w-100" id="submitBtn">
            <i class="fa-solid fa-paper-plane"></i> Place Order
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  const currency = "<%= settings.currency %>";
  const categorySelect = document.getElementById('categorySelect');
  const serviceSelect = document.getElementById('serviceSelect');
  const serviceMeta = document.getElementById('serviceMeta');
  const quantityInput = document.getElementById('quantityInput');
  const quantityHint = document.getElementById('quantityHint');
  const totalCharge = document.getElementById('totalCharge');
  const orderAlert = document.getElementById('orderAlert');
  const submitBtn = document.getElementById('submitBtn');

  // Populate category dropdown from the options already rendered.
  const seenCategories = new Set();
  [...serviceSelect.options].forEach(opt => {
    const cat = opt.dataset.category;
    if (cat && !seenCategories.has(cat)) {
      seenCategories.add(cat);
      const o = document.createElement('option');
      o.value = cat;
      o.textContent = cat;
      categorySelect.appendChild(o);
    }
  });

  categorySelect.addEventListener('change', () => {
    const cat = categorySelect.value;
    [...serviceSelect.options].forEach(opt => {
      if (!opt.value) return; // keep placeholder
      opt.hidden = cat && opt.dataset.category !== cat;
    });
    serviceSelect.value = '';
    updateCalculator();
  });

  function getSelectedOption() {
    return serviceSelect.options[serviceSelect.selectedIndex];
  }

  function updateCalculator() {
    const opt = getSelectedOption();
    if (!opt || !opt.value) {
      serviceMeta.textContent = '';
      quantityHint.textContent = 'Select a service to see min/max.';
      totalCharge.textContent = currency + ' 0.00';
      return;
    }

    const rate = parseFloat(opt.dataset.rate);
    const min = parseInt(opt.dataset.min, 10);
    const max = parseInt(opt.dataset.max, 10);

    serviceMeta.textContent = `Rate: ${currency} ${rate.toFixed(2)} per 1000`;
    quantityHint.textContent = `Min: ${min} — Max: ${max}`;
    quantityInput.min = min;
    quantityInput.max = max;

    const qty = parseInt(quantityInput.value, 10) || 0;
    const charge = (rate / 1000) * qty;
    totalCharge.textContent = currency + ' ' + charge.toFixed(2);
  }

  serviceSelect.addEventListener('change', updateCalculator);
  quantityInput.addEventListener('input', updateCalculator);

  document.getElementById('newOrderForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    orderAlert.classList.add('d-none');
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Placing order...';

    try {
      const res = await fetch('/orders/new', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          serviceId: serviceSelect.value,
          link: document.getElementById('linkInput').value,
          quantity: quantityInput.value,
        }),
      });
      const data = await res.json();

      if (data.success) {
        orderAlert.className = 'alert alert-success';
        orderAlert.textContent = 'Order placed successfully! Redirecting to My Orders...';
        orderAlert.classList.remove('d-none');
        setTimeout(() => (window.location.href = '/orders'), 1200);
      } else {
        orderAlert.className = 'alert alert-danger';
        orderAlert.textContent = data.error || 'Failed to place order.';
        orderAlert.classList.remove('d-none');
      }
    } catch (err) {
      orderAlert.className = 'alert alert-danger';
      orderAlert.textContent = 'Network error. Please try again.';
      orderAlert.classList.remove('d-none');
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Place Order';
    }
  });

  // Pre-select service if ?service=ID was passed from the Services page.
  const params = new URLSearchParams(window.location.search);
  const preselect = params.get('service');
  if (preselect) {
    serviceSelect.value = preselect;
    updateCalculator();
  }
</script>
