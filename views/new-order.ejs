<div class="page-header mb-4">
  <h3 class="fw-bold mb-1">Place a New Order</h3>
  <p class="text-muted mb-0">Select a service, enter your details, and review the live cost.</p>
</div>

<div class="row g-4">
  <!-- Order Form -->
  <div class="col-lg-7">
    <div class="card shadow-sm border-0 h-100" style="border-radius: 16px; border: 1px solid #e2e8f0;">
      <div class="card-body p-4 p-md-5">
        <div id="orderAlert" class="alert d-none"></div>

        <form id="newOrderForm">
          <div class="mb-4">
            <label class="form-label">Category</label>
            <select id="categorySelect" class="form-select">
              <option value="">All Categories</option>
            </select>
          </div>

          <div class="mb-4">
            <label class="form-label">Service</label>
            <select id="serviceSelect" name="serviceId" class="form-select" required>
              <option value="">Select a service...</option>
              <% services.forEach(s => { %>
                <option
                  value="<%= s._id %>"
                  data-category="<%= s.category %>"
                  data-name="<%= s.name %>"
                  data-desc="<%= (s.description || '').replace(/"/g, '&quot;') %>"
                  data-rate="<%= s.sellPricePer1000 %>"
                  data-min="<%= s.minOrder %>"
                  data-max="<%= s.maxOrder %>">
                  <%= s.category %> - <%= s.name %>
                </option>
              <% }) %>
            </select>
            <div class="form-text" id="serviceMeta">Select a service to see details.</div>
          </div>

          <div class="mb-4">
            <label class="form-label">Link</label>
            <input type="url" id="linkInput" name="link" class="form-control" placeholder="Enter your link here" required>
          </div>

          <div class="mb-4">
            <label class="form-label">Quantity</label>
            <input type="number" id="quantityInput" name="quantity" class="form-control" required>
            <div class="form-text" id="quantityHint">Select a service to see min/max.</div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Live Summary Card -->
  <div class="col-lg-5">
    <div class="card shadow-sm border-0 sticky-top" style="top: 90px; border-radius: 16px; border: 1px solid #e2e8f0;">
      <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
        <h5 class="fw-bold mb-0"><i class="fa-solid fa-receipt text-primary me-2"></i>Order Summary</h5>
      </div>
      <div class="card-body p-4">
        <!-- Service Details -->
        <div class="mb-4">
          <div class="text-muted small text-uppercase fw-semibold mb-2" style="font-size: 0.75rem; letter-spacing: 0.04em;">Selected Service</div>
          <div class="fw-bold text-dark" id="summaryServiceName">No service selected</div>
          <div class="small text-muted mt-1" id="summaryServiceDesc" style="display: none;"></div>
        </div>

        <!-- Calculation Grid -->
        <div class="d-flex flex-column gap-3 mb-4">
          <div class="d-flex justify-content-between align-items-center">
            <span class="text-muted">Rate</span>
            <span class="fw-medium" id="summaryRate"><%= settings.currency %> 0.00 / 1000</span>
          </div>
          <div class="d-flex justify-content-between align-items-center">
            <span class="text-muted">Average Time</span>
            <span class="fw-medium d-flex align-items-center gap-1">
              <i class="fa-solid fa-circle-info text-muted small"></i> 2 hours 48 mins
            </span>
          </div>
          <div class="d-flex justify-content-between align-items-center">
            <span class="text-muted">Quantity</span>
            <span class="fw-medium" id="summaryQuantity">0</span>
          </div>
        </div>

        <hr class="my-4" style="border-color: #e2e8f0;">

        <!-- Totals -->
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="fw-bold text-dark">Total Charge</span>
          <span class="fs-4 fw-bold text-success" id="totalCharge"><%= settings.currency %> 0.00</span>
        </div>
        
        <div class="d-flex justify-content-between align-items-center mb-4">
          <span class="text-muted small">Your Balance</span>
          <span class="fw-medium small" id="userBalance"><%= settings.currency %> <%= user.balance.toFixed(2) %></span>
        </div>

        <!-- Validation Messages -->
        <div id="validationBox" class="alert d-none mb-3" style="border-radius: 12px; padding: 0.75rem 1rem; font-size: 0.85rem;"></div>

        <!-- Submit Button -->
        <button type="submit" form="newOrderForm" class="btn btn-primary w-100 py-2.5 fw-medium" id="submitBtn" disabled>
          <i class="fa-solid fa-paper-plane"></i> Place Order
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const currency = "<%= settings.currency %>";
  const userBalance = <%= user.balance.toFixed(2) %>; // Injected for live validation
  
  const categorySelect = document.getElementById('categorySelect');
  const serviceSelect = document.getElementById('serviceSelect');
  const serviceMeta = document.getElementById('serviceMeta');
  const quantityInput = document.getElementById('quantityInput');
  const quantityHint = document.getElementById('quantityHint');
  const totalCharge = document.getElementById('totalCharge');
  const orderAlert = document.getElementById('orderAlert');
  const submitBtn = document.getElementById('submitBtn');
  
  // Summary elements
  const summaryServiceName = document.getElementById('summaryServiceName');
  const summaryServiceDesc = document.getElementById('summaryServiceDesc');
  const summaryRate = document.getElementById('summaryRate');
  const summaryQuantity = document.getElementById('summaryQuantity');
  const validationBox = document.getElementById('validationBox');
  const linkInput = document.getElementById('linkInput');

  // Populate category dropdown from the options already rendered.
  const seenCategories = new Set();
  [...serviceSelect.options].forEach(opt => {
    const cat = opt.dataset.category;
    if (cat && !seenCategories.has(cat)) {
      seenCategories.add(cat);
      const o = document.createElement('option');
      o.value = cat;
      o.textContent = cat;
      categorySelect.appendChild(o);
    }
  });

  categorySelect.addEventListener('change', () => {
    const cat = categorySelect.value;
    [...serviceSelect.options].forEach(opt => {
      if (!opt.value) return; // keep placeholder
      opt.hidden = cat && opt.dataset.category !== cat;
    });
    serviceSelect.value = '';
    updateCalculator();
  });

  function getSelectedOption() {
    return serviceSelect.options[serviceSelect.selectedIndex];
  }

  function updateLinkPlaceholder(serviceName) {
    let placeholder = 'Enter your link here';
    const lowerName = (serviceName || '').toLowerCase();
    
    if (lowerName.includes('instagram')) placeholder = 'https://www.instagram.com/username';
    else if (lowerName.includes('facebook')) placeholder = 'https://www.facebook.com/page';
    else if (lowerName.includes('youtube')) placeholder = 'https://www.youtube.com/watch?v=...';
    else if (lowerName.includes('twitter') || lowerName.includes('x.com')) placeholder = 'https://twitter.com/username';
    else if (lowerName.includes('tiktok')) placeholder = 'https://www.tiktok.com/@username';
    
    linkInput.placeholder = placeholder;
  }

  function updateCalculator() {
    const opt = getSelectedOption();
    
    // Reset validation UI
    validationBox.className = 'alert d-none mb-3';
    validationBox.innerHTML = '';
    let isValid = true;
    let warnings = [];

    if (!opt || !opt.value) {
      serviceMeta.textContent = 'Select a service to see details.';
      quantityHint.textContent = 'Select a service to see min/max.';
      totalCharge.textContent = currency + ' 0.00';
      summaryServiceName.textContent = 'No service selected';
      summaryServiceDesc.style.display = 'none';
      summaryRate.textContent = currency + ' 0.00 / 1000';
      summaryQuantity.textContent = '0';
      quantityInput.value = '';
      linkInput.placeholder = 'Enter your link here';
      submitBtn.disabled = true;
      return;
    }

    const rate = parseFloat(opt.dataset.rate);
    const min = parseInt(opt.dataset.min, 10);
    const max = parseInt(opt.dataset.max, 10);
    const name = opt.dataset.name;
    const desc = opt.dataset.desc;

    // Update UI Elements
    serviceMeta.innerHTML = `<i class="fa-solid fa-tag me-1 text-muted"></i> Rate: ${currency} ${rate.toFixed(2)} per 1000`;
    quantityHint.innerHTML = `<i class="fa-solid fa-sliders me-1 text-muted"></i> Min: ${min} — Max: ${max}`;
    quantityInput.min = min;
    quantityInput.max = max;
    
    summaryServiceName.textContent = name;
    if (desc) {
      summaryServiceDesc.style.display = 'block';
      summaryServiceDesc.textContent = desc;
    } else {
      summaryServiceDesc.style.display = 'none';
    }
    summaryRate.textContent = `${currency} ${rate.toFixed(2)} / 1000`;
    
    updateLinkPlaceholder(name);

    const qty = parseInt(quantityInput.value, 10) || 0;
    summaryQuantity.textContent = qty.toLocaleString();

    const charge = (rate / 1000) * qty;
    totalCharge.textContent = currency + ' ' + charge.toFixed(2);

    // Validation Logic
    if (qty === 0) {
      isValid = false; // Don't show warning, just disable
    }
    if (qty > 0 && qty < min) {
      isValid = false;
      warnings.push(`<i class="fa-solid fa-triangle-exclamation me-2"></i> Minimum quantity is ${min}.`);
    }
    if (qty > max) {
      isValid = false;
      warnings.push(`<i class="fa-solid fa-triangle-exclamation me-2"></i> Maximum quantity is ${max}.`);
    }
    if (charge > userBalance && qty > 0) {
      isValid = false;
      warnings.push(`<i class="fa-solid fa-wallet me-2"></i> Insufficient balance. Please <a href="/add-funds" class="alert-link">add funds</a>.`);
    }

    // Apply validation styles
    if (warnings.length > 0) {
      validationBox.className = 'alert alert-danger mb-3';
      validationBox.innerHTML = warnings.join('<br>');
    } else if (qty > 0) {
      validationBox.className = 'alert alert-success mb-3';
      validationBox.innerHTML = '<i class="fa-solid fa-circle-check me-2"></i> Ready to place order.';
    }

    submitBtn.disabled = !isValid;
  }

  serviceSelect.addEventListener('change', updateCalculator);
  quantityInput.addEventListener('input', updateCalculator);

  document.getElementById('newOrderForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    orderAlert.classList.add('d-none');
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Placing order...';

    try {
      const res = await fetch('/orders/new', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          serviceId: serviceSelect.value,
          link: document.getElementById('linkInput').value,
          quantity: quantityInput.value,
        }),
      });
      const data = await res.json();

      if (data.success) {
        orderAlert.className = 'alert alert-success';
        orderAlert.textContent = 'Order placed successfully! Redirecting to My Orders...';
        orderAlert.classList.remove('d-none');
        setTimeout(() => (window.location.href = '/orders'), 1200);
      } else {
        orderAlert.className = 'alert alert-danger';
        orderAlert.textContent = data.error || 'Failed to place order.';
        orderAlert.classList.remove('d-none');
      }
    } catch (err) {
      orderAlert.className = 'alert alert-danger';
      orderAlert.textContent = 'Network error. Please try again.';
      orderAlert.classList.remove('d-none');
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Place Order';
    }
  });

  // Pre-select service if ?service=ID was passed from the Services page.
  const params = new URLSearchParams(window.location.search);
  const preselect = params.get('service');
  if (preselect) {
    serviceSelect.value = preselect;
    updateCalculator();
  }
</script>
