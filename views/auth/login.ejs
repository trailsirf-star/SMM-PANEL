<style>
  .btn-google {
    background-color: #fff;
    border: 1px solid #dadce0;
    color: #3c4043;
    font-weight: 500;
    border-radius: 8px;
    padding: 0.65rem 1rem;
    transition: all .2s ease;
    text-decoration: none;
  }

  .btn-google:hover {
    background: #f8f9fa;
    color: #202124;
    border-color: #c6c6c6;
    box-shadow: 0 2px 8px rgba(0,0,0,.08);
  }
</style>

<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card shadow-sm border-0 mt-4">
      <div class="card-body p-4">

        <h4 class="fw-bold text-center mb-4">
          <i class="fa-solid fa-bolt text-primary"></i>
          Log In
        </h4>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger py-2">
            <%= error %>
          </div>
        <% } %>

        <form method="POST" action="/login">

          <div class="mb-3">
            <label class="form-label">Email address</label>
            <input
              type="email"
              name="email"
              class="form-control"
              required
              autofocus
            >
          </div>

          <div class="mb-3">
            <label class="form-label">Password</label>
            <input
              type="password"
              name="password"
              class="form-control"
              required
            >
          </div>

          <div class="form-check mb-3">
            <input
              class="form-check-input"
              type="checkbox"
              name="rememberMe"
              id="rememberMe"
            >
            <label class="form-check-label" for="rememberMe">
              Remember me
            </label>
          </div>

          <button type="submit" class="btn btn-primary w-100">
            Log In
          </button>

        </form>

        <p class="text-center mt-4 mb-3">
          Don't have an account?
          <a href="/signup">Sign up</a>
        </p>

        <div class="text-center">

          <div class="text-muted small mb-3">
            Or continue with
          </div>

          <a
            href="/auth/google"
            class="btn btn-google d-inline-flex align-items-center gap-2 px-4"
          >

            <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
              <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615z"/>
              <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/>
              <path fill="#FBBC05" d="M3.964 10.706A5.41 5.41 0 0 1 3.68 9c0-.593.102-1.17.284-1.706V4.962H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.038l3.007-2.332z"/>
              <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.962L3.964 7.294C4.672 5.167 6.656 3.58 9 3.58z"/>
            </svg>

            Continue with Google

          </a>

        </div>

      </div>
    </div>
  </div>
</div>
