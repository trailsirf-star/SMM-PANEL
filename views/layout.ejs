<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' | SMM Panel' : 'SMM Panel' %></title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <%- typeof extraStyles !== 'undefined' ? extraStyles : '' %>
</head>
<body>

  <% const isAdminArea = typeof currentPath !== 'undefined' && currentPath.startsWith('/admin') && user && user.role === 'admin'; %>

  <% if (!isAdminArea) { %>
    <%- include('partials/navbar') %>
    <main class="container py-4">
      <%- body %>
    </main>
    <%- include('partials/footer') %>
  <% } else { %>
    <div class="admin-shell d-flex">
      <%- include('partials/sidebar-admin') %>
      <div class="admin-content flex-grow-1">
        <nav class="navbar navbar-expand navbar-light bg-white border-bottom px-3">
          <span class="navbar-brand fw-bold"><i class="fa-solid fa-gauge"></i> Admin Panel</span>
          <div class="ms-auto d-flex align-items-center gap-3">
            <span class="text-muted small">Logged in as <strong><%= user.name %></strong></span>
            <a href="/dashboard" class="btn btn-sm btn-outline-secondary">User View</a>
            <a href="/logout" class="btn btn-sm btn-outline-danger">Logout</a>
          </div>
        </nav>
        <main class="p-4">
          <%- body %>
        </main>
      </div>
    </div>
  <% } %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
  <%- typeof extraScripts !== 'undefined' ? extraScripts : '' %>
</body>
</html>
