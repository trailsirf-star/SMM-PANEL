<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' | MRFSMM' : 'MRFSMM' %></title>

  <!-- Bootstrap & FontAwesome (Preserved) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  
  <!-- Premium SaaS Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  
  <%- typeof extraStyles !== 'undefined' ? extraStyles : '' %>
  
  <style>
    /* Core Layout Enhancements for Premium SaaS Feel */
    body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background-color: #f8fafc; color: #0f172a; -webkit-font-smoothing: antialiased; }
    
    /* Admin Layout Shell */
    .admin-shell { display: flex; min-height: 100vh; background-color: #f8fafc; }
    .admin-content { 
      flex-grow: 1; 
      display: flex; 
      flex-direction: column; 
      min-width: 0; 
      margin-left: 260px; 
      transition: margin 0.3s ease; 
    }
    
    /* Premium Admin Topbar */
    .admin-topbar {
      height: 64px;
      background-color: #ffffff;
      border-bottom: 1px solid #e2e8f0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.5rem;
      position: sticky;
      top: 0;
      z-index: 1020;
    }
    .topbar-search { position: relative; width: 320px; max-width: 100%; }
    .topbar-search input { 
      padding-left: 2.5rem; 
      background-color: #f1f5f9; 
      border: 1px solid transparent; 
      border-radius: 8px; 
      height: 40px; 
      font-size: 0.9rem;
    }
    .topbar-search input:focus { 
      background-color: #fff; 
      border-color: #4f46e5; 
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1); 
    }
    .topbar-search i { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: #94a3b8; }
    
    .admin-avatar { 
      width: 36px; height: 36px; border-radius: 8px; 
      background: linear-gradient(135deg, #4f46e5, #818cf8); 
      display: flex; align-items: center; justify-content: center; 
      color: #fff; font-weight: 700; font-size: 0.9rem;
    }
    
  </style>
</head>
<body>

  <% const isAdminArea = typeof currentPath !== 'undefined' && currentPath.startsWith('/admin') && user && user.role === 'admin'; %>
  <% const isUserShell = !isAdminArea && user; %>

  <% if (!isAdminArea && !isUserShell) { %>
    <%- include('partials/navbar') %>
    <main class="container py-4 py-md-5">
      <%- body %>
    </main>
    <%- include('partials/footer') %>
  <% } else { %>
    <div class="admin-shell">
      <% if (isAdminArea) { %>
        <%- include('partials/sidebar-admin') %>
      <% } else { %>
        <%- include('partials/sidebar-user') %>
      <% } %>

      <!-- Mobile overlay (click to close; handled by /js/main.js) -->
      <div class="sidebar-overlay"></div>

      <div class="admin-content">
        <!-- Premium Top Navbar -->
        <nav class="admin-topbar">
          <div class="d-flex align-items-center gap-3">
            <button class="btn btn-light btn-sm d-lg-none p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; border: 1px solid #e2e8f0;" data-sidebar-toggle aria-label="Toggle menu" aria-expanded="false">
              <i class="fa-solid fa-bars"></i>
            </button>
            <% if (isAdminArea) { %>
              <div class="topbar-search d-none d-md-block">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" class="form-control" placeholder="Search...">
              </div>
            <% } else { %>
              <span class="badge d-inline-flex align-items-center gap-2 px-3 py-2" style="background-color: #ecfdf5; color: #065f46; font-weight: 600; border-radius: 999px; font-size: 0.9rem;">
                <i class="fa-solid fa-wallet"></i> Rs. <%= user.balance.toFixed(2) %>
              </span>
            <% } %>
          </div>

          <div class="d-flex align-items-center gap-3">
            <% if (isAdminArea) { %>
              <a href="/dashboard" class="btn btn-sm btn-light d-none d-sm-inline-flex align-items-center gap-2" style="border: 1px solid #e2e8f0; color: #475569; font-weight: 500;">
                <i class="fa-solid fa-arrow-right-from-bracket"></i> User View
              </a>
            <% } else if (user.role === 'admin') { %>
              <a href="/admin/dashboard" class="btn btn-sm btn-light d-none d-sm-inline-flex align-items-center gap-2" style="border: 1px solid #e2e8f0; color: #475569; font-weight: 500;">
                <i class="fa-solid fa-user-shield"></i> Admin Panel
              </a>
            <% } %>
            <div class="dropdown">
              <a href="#" class="d-flex align-items-center gap-2 text-decoration-none text-dark" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
                <div class="admin-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
                <div class="d-none d-md-block lh-sm">
                  <div class="fw-bold" style="font-size: 0.9rem;"><%= user.name %></div>
                  <div class="text-muted" style="font-size: 0.75rem;"><%= isAdminArea ? 'Administrator' : 'My Account' %></div>
                </div>
                <i class="fa-solid fa-chevron-down text-muted small d-none d-md-block"></i>
              </a>
              <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" style="border-radius: 12px; padding: 0.5rem; min-width: 200px;">
                <li><a class="dropdown-item rounded-2 py-2 px-3 d-flex align-items-center gap-2 text-dark" href="/profile"><i class="fa-solid fa-user text-muted w-4"></i> My Profile</a></li>
                <% if (isAdminArea) { %>
                  <li><a class="dropdown-item rounded-2 py-2 px-3 d-flex align-items-center gap-2 text-dark" href="/dashboard"><i class="fa-solid fa-eye text-muted w-4"></i> User View</a></li>
                <% } %>
                <li><hr class="dropdown-divider my-2"></li>
                <li><a class="dropdown-item rounded-2 py-2 px-3 d-flex align-items-center gap-2 text-danger" href="/logout"><i class="fa-solid fa-right-from-bracket w-4"></i> Logout</a></li>
              </ul>
            </div>
          </div>
        </nav>

        <main class="p-4 p-md-5 flex-grow-1">
          <%- body %>
        </main>
      </div>
    </div>
  <% } %>

  <!-- Scripts (Preserved) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>

  <%- script || '' %>

</body>
</html>
