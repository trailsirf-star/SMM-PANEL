<div class="af-header mb-4">
  <h3 class="fw-bold mb-1">Add Funds</h3>
  <p class="text-muted mb-0">Choose a payment method below, send your deposit, then submit the amount and screenshot for review.</p>
</div>

<% if (typeof message !== 'undefined' && message) { %>
  <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
    <i class="fa-solid fa-circle-check"></i> <%= message %>
  </div>
<% } %>
<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
    <i class="fa-solid fa-triangle-exclamation"></i> <%= error %>
  </div>
<% } %>

<div class="row g-4">
  <!-- ================= PAYMENT METHOD CARD ================= -->
  <div class="col-lg-7">
    <div class="card af-card border-0 h-100">

      <!-- Method switcher -->
      <ul class="nav nav-pills af-tabs gap-2 mb-4" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active af-tab af-tab-easypaisa d-flex align-items-center gap-2" data-bs-toggle="tab" data-bs-target="#easypaisaPanel" type="button" role="tab" aria-controls="easypaisaPanel" aria-selected="true">
            <img src="/images/easypaisa-logo.png" alt="" class="af-tab-logo">
            <span>EasyPaisa</span>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link af-tab af-tab-binance d-flex align-items-center gap-2" data-bs-toggle="tab" data-bs-target="#binancePanel" type="button" role="tab" aria-controls="binancePanel" aria-selected="false">
            <img src="/images/binance-logo.png" alt="" class="af-tab-logo af-tab-logo-dark">
            <span>Binance</span>
          </button>
        </li>
      </ul>

      <div class="tab-content">

        <!-- ---- EasyPaisa Panel ---- -->
        <div class="tab-pane fade show active" id="easypaisaPanel" role="tabpanel">
          <span class="af-method-chip af-chip-green mb-3">
            <i class="fa-solid fa-bolt"></i> EASYPAISA TRANSFER
          </span>

          <div class="af-method-head mb-4">
            <span class="af-logo-tile">
              <img src="/images/easypaisa-logo.png" alt="EasyPaisa">
            </span>
            <div>
              <div class="af-method-title">EasyPaisa</div>
              <div class="af-method-sub">Mobile account transfer</div>
            </div>
          </div>

          <div class="af-field mb-3">
            <div class="af-field-label">Account Name</div>
            <div class="af-field-value"><%= settings.easypaisaAccountName || 'Nihayat Begum' %></div>
          </div>

          <div class="af-field af-field-primary mb-4">
            <div class="af-field-label">Account Number</div>
            <div class="af-field-copy-row">
              <input type="text" class="af-account-number-input" id="easypaisaNumberInput"
                     value="<%= settings.easypaisaNumber || '03439898333' %>" readonly aria-label="EasyPaisa account number">
              <button type="button" class="af-copy-btn" data-copy-input="easypaisaNumberInput" onclick="afCopyValue(this)">
                <i class="fa-regular fa-copy"></i><span>Copy</span>
              </button>
            </div>
          </div>

          <div class="af-steps">
            <div class="af-steps-title"><i class="fa-solid fa-list-check me-1 text-muted"></i> What to do next</div>
            <ol class="af-steps-list">
              <li>Send at least <strong><%= settings.currency %> <%= settings.minimumDeposit %></strong> to the EasyPaisa account above.</li>
              <li>Take a clear screenshot of the successful transaction.</li>
              <li>Enter the amount and upload the screenshot in the form on the right.</li>
              <li>Your balance is credited as soon as admin approves the request.</li>
            </ol>
          </div>
        </div>

        <!-- ---- Binance Panel (placeholder — no wallet data in backend yet) ---- -->
        <div class="tab-pane fade" id="binancePanel" role="tabpanel">
          <span class="af-method-chip af-chip-gold mb-3">
            <i class="fa-solid fa-clock"></i> BINANCE — COMING SOON
          </span>

          <div class="af-method-head mb-4">
            <span class="af-logo-tile">
              <img src="/images/binance-logo.png" alt="Binance">
            </span>
            <div>
              <div class="af-method-title">Binance</div>
              <div class="af-method-sub">USDT deposit</div>
            </div>
          </div>

          <div class="af-field af-field-muted mb-3">
            <div class="af-field-label">Network</div>
            <div class="af-field-value af-placeholder-value">To be announced</div>
          </div>

          <div class="af-field af-field-muted mb-4">
            <div class="af-field-label">Wallet Address / UID</div>
            <div class="af-field-copy-row">
              <div class="af-field-value af-placeholder-value">Coming soon</div>
              <button type="button" class="af-copy-btn" disabled aria-disabled="true">
                <i class="fa-regular fa-copy"></i><span>Copy</span>
              </button>
            </div>
          </div>

          <div class="af-note">
            <i class="fa-solid fa-circle-info"></i>
            <span>Binance deposits aren't active yet — please use EasyPaisa for now. This card is ready to switch on as soon as wallet details are added.</span>
          </div>
          <!--
            To activate Binance: replace the two placeholder values above
            (Network, Wallet Address / UID) with the real details.
            This panel is static markup only — no backend or schema change
            is required to fill it in.
          -->
        </div>

      </div>
    </div>
  </div>

  <!-- ================= SUBMIT PAYMENT PROOF CARD ================= -->
  <div class="col-lg-5">
    <div class="card af-card af-submit-card border-0 h-100 sticky-top" style="top: 90px;">
      <div class="af-submit-head mb-4">
        <div class="af-submit-icon"><i class="fa-solid fa-paper-plane"></i></div>
        <div>
          <div class="af-method-title af-submit-title">Submit Payment Proof</div>
          <div class="af-method-sub">After sending money, confirm it here</div>
        </div>
      </div>

      <form method="POST" action="/add-funds" enctype="multipart/form-data">
        <div class="mb-3">
          <label class="form-label">Amount</label>
          <div class="input-group af-amount-group">
            <span class="input-group-text af-amount-prefix"><%= settings.currency %></span>
            <input type="number" name="amount" min="<%= settings.minimumDeposit %>" step="0.01"
                   class="form-control" placeholder="0.00" required>
          </div>
          <div class="form-text">Minimum deposit: <%= settings.currency %> <%= settings.minimumDeposit %></div>
        </div>

        <div class="mb-4">
          <label class="form-label">Payment Screenshot</label>
          <input type="file" name="screenshot" accept="image/png,image/jpeg,image/webp"
                 class="form-control" id="screenshotInput" required>
          <div class="form-text" id="screenshotFileName">PNG, JPG or WEBP — up to 5MB.</div>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 fw-medium">
          <i class="fa-solid fa-circle-check"></i> Submit for Review
        </button>
      </form>
    </div>
  </div>
</div>

<!-- ================= RECENT FUND REQUESTS (UNCHANGED) ================= -->
<div class="card shadow-sm border-0 mt-4">
  <div class="card-header bg-white fw-semibold">Recent Fund Requests</div>
  <div class="table-responsive">
    <table class="table mb-0 align-middle">
      <thead class="table-light">
        <tr>
          <th>Amount</th>
          <th>Status</th>
          <th>Admin Note</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody>
        <% if (recent.length === 0) { %>
          <tr><td colspan="4" class="text-center text-muted py-4">No fund requests yet.</td></tr>
        <% } %>
        <% recent.forEach(tx => { %>
          <tr>
            <td><%= settings.currency %> <%= tx.amount.toFixed(2) %></td>
            <td>
              <span class="badge
                <%= tx.status === 'approved' ? 'bg-success' : tx.status === 'rejected' ? 'bg-danger' : 'bg-warning text-dark' %>">
                <%= tx.status %>
              </span>
            </td>
            <td><%= tx.adminNote || '-' %></td>
            <td><%= tx.createdAt.toLocaleString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<style>
  /* =========================================
     ADD FUNDS — PAYMENT SECTION (scoped to this page)
     ========================================= */
  .af-card { border-radius: 20px; padding: 1.75rem; }

  /* Method tabs */
  .af-tabs { flex-wrap: wrap; }
  .af-tabs .nav-link.af-tab {
    background-color: #f1f5f9;
    color: var(--text-secondary);
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 0.6rem 1.1rem;
    font-weight: 600;
    font-size: 0.9rem;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .af-tabs .nav-link.af-tab:hover { background-color: #e2e8f0; }
  .af-tabs .nav-link.af-tab.active.af-tab-easypaisa {
    background-color: #ecfdf5; color: #047857; border-color: #a7f3d0;
  }
  .af-tabs .nav-link.af-tab.active.af-tab-binance {
    background-color: #fffbeb; color: #92400e; border-color: #fde68a;
  }
  .af-tab-logo { height: 20px; width: auto; border-radius: 4px; display: block; }
  .af-tab-logo-dark { padding: 1px; }

  /* Method chip badge */
  .af-method-chip {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    padding: 0.35rem 0.75rem; border-radius: 999px;
  }
  .af-chip-green { background-color: #ecfdf5; color: #047857; }
  .af-chip-gold { background-color: #fffbeb; color: #92400e; }

  /* Method header (logo + title) */
  .af-method-head { display: flex; align-items: center; gap: 1rem; }
  .af-logo-tile {
    display: inline-flex; align-items: center; justify-content: center;
    width: 64px; height: 64px; flex-shrink: 0;
    border-radius: 16px; overflow: hidden;
    background-color: #ffffff; border: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
  }
  .af-logo-tile img { width: 100%; height: 100%; object-fit: contain; padding: 10px; }
  .af-method-title { font-size: 1.15rem; font-weight: 700; color: var(--text-primary); line-height: 1.3; }
  .af-submit-title { font-size: 1.05rem; }
  .af-method-sub { font-size: 0.85rem; color: var(--text-secondary); }

  /* Field rows */
  .af-field {
    background-color: #f8fafc; border: 1px solid var(--border-color);
    border-radius: 14px; padding: 1rem 1.25rem;
    transition: box-shadow 0.2s ease;
  }
  .af-field-label {
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--text-secondary); margin-bottom: 0.35rem;
  }
  .af-field-value { font-size: 1.05rem; font-weight: 600; color: var(--text-primary); }
  .af-field-copy-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }

  .af-field-primary {
    background: linear-gradient(135deg, #ecfdf5, #f0fdf4);
    border-color: #a7f3d0;
  }
  .af-field-primary:hover { box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.08); }
  .af-account-number-input {
    border: none; background: transparent; outline: none; padding: 0; margin: 0;
    font-family: inherit; font-size: 1.65rem; font-weight: 800; letter-spacing: 0.03em;
    color: #047857; font-variant-numeric: tabular-nums;
    width: auto; max-width: 100%;
  }

  .af-field-muted { border-style: dashed; }
  .af-placeholder-value { color: var(--text-muted); font-style: italic; font-weight: 500; }

  /* Copy button */
  .af-copy-btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background-color: #0f172a; color: #ffffff; border: none;
    padding: 0.55rem 1rem; border-radius: 10px;
    font-weight: 600; font-size: 0.85rem; white-space: nowrap;
    transition: transform 0.15s ease, background-color 0.2s ease;
  }
  .af-copy-btn:hover:not(:disabled) { background-color: #1e293b; transform: translateY(-1px); }
  .af-copy-btn:active:not(:disabled) { transform: translateY(0); }
  .af-copy-btn:disabled { background-color: #e2e8f0; color: #94a3b8; cursor: not-allowed; }
  .af-copy-btn.af-copied { background-color: #059669; }

  /* Steps / note boxes */
  .af-steps, .af-note {
    background-color: #f8fafc; border: 1px solid var(--border-color); border-radius: 14px;
  }
  .af-steps { padding: 1.1rem 1.4rem; }
  .af-steps-title { font-weight: 700; font-size: 0.85rem; margin-bottom: 0.65rem; color: var(--text-primary); }
  .af-steps-list { margin: 0; padding-left: 1.1rem; color: var(--text-secondary); font-size: 0.88rem; display: flex; flex-direction: column; gap: 0.4rem; }

  .af-note { display: flex; align-items: flex-start; gap: 0.6rem; font-size: 0.85rem; color: var(--text-secondary); padding: 1rem 1.25rem; }
  .af-note i { color: #f0b90b; margin-top: 0.15rem; }

  /* Submit card */
  .af-submit-head { display: flex; align-items: center; gap: 0.9rem; }
  .af-submit-icon {
    width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0;
    background: linear-gradient(135deg, var(--brand-primary), #818cf8);
    color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.05rem;
  }
  .af-amount-prefix { background-color: #f1f5f9; color: var(--text-secondary); font-weight: 600; border-color: var(--border-color); }

  @media (max-width: 576px) {
    .af-card { padding: 1.25rem; }
    .af-logo-tile { width: 52px; height: 52px; border-radius: 14px; }
    .af-account-number-input { font-size: 1.35rem; }
    .af-method-title { font-size: 1.05rem; }
  }
</style>

<script>
  // Copy-to-clipboard for payment fields (same pattern used on Profile / Refer & Earn).
  function afCopyValue(btn) {
    const inputId = btn.getAttribute('data-copy-input');
    const input = document.getElementById(inputId);
    if (!input) return;

    input.select();
    input.setSelectionRange(0, 99999); // mobile Safari
    try {
      document.execCommand('copy');
    } catch (e) {
      // Clipboard copy isn't critical — the value is already visible for manual copy.
    }
    input.blur();

    const label = btn.querySelector('span');
    const icon = btn.querySelector('i');
    const originalLabel = label.textContent;
    const originalIconClass = icon.className;

    label.textContent = 'Copied!';
    icon.className = 'fa-solid fa-check';
    btn.classList.add('af-copied');

    setTimeout(() => {
      label.textContent = originalLabel;
      icon.className = originalIconClass;
      btn.classList.remove('af-copied');
    }, 1500);
  }

  // Show the selected filename as a small confirmation (purely cosmetic).
  const afScreenshotInput = document.getElementById('screenshotInput');
  if (afScreenshotInput) {
    afScreenshotInput.addEventListener('change', function () {
      const label = document.getElementById('screenshotFileName');
      if (this.files && this.files[0]) {
        label.textContent = this.files[0].name;
      } else {
        label.textContent = 'PNG, JPG or WEBP — up to 5MB.';
      }
    });
  }
</script>
