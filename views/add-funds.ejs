<%
  /* ------------------------------------------------------------------
     Reusing existing backend values only. No controller/model/route
     changes. Binance fields are read defensively (optional chaining
     style fallbacks) since the current Settings schema does not yet
     define them — nothing breaks if they are undefined, and this page
     will "light up" automatically the moment those fields are added.
  ------------------------------------------------------------------ */
  const binanceId      = settings.binancePayId || settings.binanceId || null;
  const binanceAddress = settings.binanceWalletAddress || settings.binanceAddress || null;
  const binanceNetwork = settings.binanceNetwork || null;
  const hasBinance      = !!(binanceId || binanceAddress);
%>

<div class="af">

  <div class="af-head">
    <div class="af-head-icon"><i class="fa-solid fa-wallet"></i></div>
    <div>
      <h1 class="af-title">Add Funds</h1>
      <p class="af-subtitle">Top up your balance securely using EasyPaisa or Binance. After payment upload your payment proof and our team will verify it shortly.</p>
    </div>
  </div>

  <% if (typeof message !== 'undefined' && message) { %>
    <div class="af-banner af-banner-success">
      <i class="fa-solid fa-circle-check"></i>
      <span><%= message %></span>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="af-banner af-banner-error">
      <i class="fa-solid fa-triangle-exclamation"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- ===================== PAYMENT METHOD CARDS ===================== -->
  <div class="af-methods">

    <!-- EasyPaisa -->
    <div class="af-pay-card af-pay-card-green">
      <div class="af-pay-top">
        <div class="af-brand">
          <span class="af-logo af-logo-easypaisa">
            <img src="/images/easypaisa-logo.png" alt="EasyPaisa" onerror="this.style.display='none'; this.parentElement.classList.add('af-logo-fallback-active');">
            <span class="af-logo-fallback">EP</span>
          </span>
          <div>
            <div class="af-pay-name">EasyPaisa</div>
            <div class="af-pay-type">Mobile Wallet Transfer</div>
          </div>
        </div>
        <span class="af-verified"><i class="fa-solid fa-circle-check"></i> Official EasyPaisa</span>
      </div>

      <div class="af-field">
        <span class="af-field-label">Payment Method</span>
        <span class="af-field-value"><%= settings.paymentMethodLabel || 'EasyPaisa' %></span>
      </div>
      <div class="af-field">
        <span class="af-field-label">Account Name</span>
        <span class="af-field-value"><%= settings.easypaisaAccountName || 'Not configured yet' %></span>
      </div>

      <div class="af-number-box">
        <span class="af-number-label">Account Number</span>
        <div class="af-number-row">
          <span class="af-number"><%= settings.easypaisaNumber || 'Not configured yet' %></span>
          <button type="button" class="af-copy-btn" data-copy="<%= settings.easypaisaNumber || '' %>" aria-label="Copy EasyPaisa account number">
            <i class="fa-regular fa-copy"></i>
            <i class="fa-solid fa-check"></i>
            <span class="af-copy-label">Copy</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Binance -->
    <div class="af-pay-card af-pay-card-gold">
      <div class="af-pay-top">
        <div class="af-brand">
          <span class="af-logo af-logo-binance">
            <img src="/images/binance-logo.png" alt="Binance" onerror="this.style.display='none'; this.parentElement.classList.add('af-logo-fallback-active');">
            <span class="af-logo-fallback"><i class="fa-solid fa-coins"></i></span>
          </span>
          <div>
            <div class="af-pay-name">Binance</div>
            <div class="af-pay-type">Crypto Payment</div>
          </div>
        </div>
        <% if (hasBinance) { %>
          <span class="af-verified"><i class="fa-solid fa-circle-check"></i> Verified Binance</span>
        <% } %>
      </div>

      <% if (hasBinance) { %>
        <% if (binanceId) { %>
          <div class="af-field">
            <span class="af-field-label">Binance Pay ID</span>
            <span class="af-field-value"><%= binanceId %></span>
          </div>
        <% } %>
        <% if (binanceNetwork) { %>
          <div class="af-field">
            <span class="af-field-label">Network</span>
            <span class="af-field-value"><%= binanceNetwork %></span>
          </div>
        <% } %>
        <% if (binanceAddress) { %>
          <div class="af-number-box">
            <span class="af-number-label">Wallet Address</span>
            <div class="af-number-row">
              <span class="af-number af-number-wrap"><%= binanceAddress %></span>
              <button type="button" class="af-copy-btn" data-copy="<%= binanceAddress %>" aria-label="Copy Binance wallet address">
                <i class="fa-regular fa-copy"></i>
                <i class="fa-solid fa-check"></i>
                <span class="af-copy-label">Copy</span>
              </button>
            </div>
          </div>
        <% } else if (binanceId) { %>
          <div class="af-number-box">
            <span class="af-number-label">Binance Pay ID</span>
            <div class="af-number-row">
              <span class="af-number"><%= binanceId %></span>
              <button type="button" class="af-copy-btn" data-copy="<%= binanceId %>" aria-label="Copy Binance Pay ID">
                <i class="fa-regular fa-copy"></i>
                <i class="fa-solid fa-check"></i>
                <span class="af-copy-label">Copy</span>
              </button>
            </div>
          </div>
        <% } %>
      <% } else { %>
        <div class="af-soon-state">
          <div class="af-soon-icon"><i class="fa-regular fa-clock"></i></div>
          <div class="af-soon-title">Coming Soon</div>
          <div class="af-soon-desc">Binance payments will be available shortly. Please use EasyPaisa for now.</div>
        </div>
      <% } %>
    </div>

  </div>

  <!-- ===================== HOW TO PAY TIMELINE ===================== -->
  <div class="af-card">
    <h2 class="af-card-title">How to Pay</h2>
    <div class="af-timeline">
      <div class="af-step">
        <div class="af-step-icon"><i class="fa-solid fa-hand-pointer"></i></div>
        <div class="af-step-body">
          <div class="af-step-title">Choose payment method</div>
          <div class="af-step-desc">Pick EasyPaisa or Binance above.</div>
        </div>
      </div>
      <div class="af-step">
        <div class="af-step-icon"><i class="fa-solid fa-paper-plane"></i></div>
        <div class="af-step-body">
          <div class="af-step-title">Send payment</div>
          <div class="af-step-desc">Transfer the amount to the account shown.</div>
        </div>
      </div>
      <div class="af-step">
        <div class="af-step-icon"><i class="fa-solid fa-camera"></i></div>
        <div class="af-step-body">
          <div class="af-step-title">Take screenshot</div>
          <div class="af-step-desc">Capture proof of your successful payment.</div>
        </div>
      </div>
      <div class="af-step">
        <div class="af-step-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
        <div class="af-step-body">
          <div class="af-step-title">Upload screenshot</div>
          <div class="af-step-desc">Attach it in the form below and submit.</div>
        </div>
      </div>
      <div class="af-step">
        <div class="af-step-icon"><i class="fa-solid fa-user-shield"></i></div>
        <div class="af-step-body">
          <div class="af-step-title">Admin verifies</div>
          <div class="af-step-desc">Our team manually checks every payment.</div>
        </div>
      </div>
      <div class="af-step af-step-last">
        <div class="af-step-icon af-step-icon-final"><i class="fa-solid fa-circle-check"></i></div>
        <div class="af-step-body">
          <div class="af-step-title">Balance added</div>
          <div class="af-step-desc">Funds appear in your account instantly after approval.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===================== PAYMENT STATUS ===================== -->
  <div class="af-status-card">
    <span class="af-status-dot"></span>
    <div class="af-status-text">
      <div class="af-status-title">Manual Verification</div>
      <div class="af-status-sub">Average approval time: <strong>5–15 Minutes</strong></div>
    </div>
  </div>

  <!-- ===================== SUBMIT FORM ===================== -->
  <div class="af-card af-card-glass">
    <h2 class="af-card-title">Submit Your Payment</h2>

    <form method="POST" action="/add-funds" enctype="multipart/form-data" id="addFundsForm">
      <div class="af-form-group">
        <label class="af-label" for="amountInput">Amount</label>
        <div class="af-amount-wrap">
          <span class="af-amount-currency"><%= settings.currency %></span>
          <input
            type="number"
            id="amountInput"
            name="amount"
            min="<%= settings.minimumDeposit %>"
            step="0.01"
            class="af-input af-amount-input"
            placeholder="0.00"
            required
          >
        </div>
        <span class="af-hint">Minimum deposit: <%= settings.currency %> <%= settings.minimumDeposit %></span>
      </div>

      <div class="af-form-group">
        <label class="af-label">Payment Screenshot</label>
        <div class="af-dropzone" id="dropzone" tabindex="0" role="button" aria-label="Upload payment screenshot">
          <input type="file" name="screenshot" id="screenshotInput" accept="image/png,image/jpeg,image/webp" required hidden>

          <div class="af-dropzone-empty" id="dropzoneEmpty">
            <div class="af-dropzone-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
            <div class="af-dropzone-text">
              <strong>Click to upload</strong> or drag and drop
            </div>
            <div class="af-dropzone-sub">PNG, JPG, JPEG or WEBP</div>
          </div>

          <div class="af-dropzone-filled" id="dropzoneFilled" hidden>
            <img id="dropzonePreview" class="af-dropzone-preview" alt="Screenshot preview">
            <div class="af-dropzone-fileinfo">
              <div class="af-dropzone-filename" id="dropzoneFilename"></div>
              <div class="af-dropzone-filesize" id="dropzoneFilesize"></div>
              <div class="af-dropzone-actions">
                <button type="button" class="af-replace-btn" id="replaceBtn">
                  <i class="fa-solid fa-arrows-rotate"></i> Replace image
                </button>
                <button type="button" class="af-remove-btn" id="removeBtn">
                  <i class="fa-solid fa-trash-can"></i> Remove
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <button type="submit" class="af-submit-btn" id="submitBtn">
        <span class="af-submit-label">Submit for Review</span>
        <span class="af-submit-spinner"><i class="fa-solid fa-circle-notch fa-spin"></i> Submitting...</span>
      </button>
    </form>
  </div>

  <!-- ===================== PAYMENT TIPS ===================== -->
  <div class="af-tips-card">
    <div class="af-tips-header">
      <div class="af-security-icon"><i class="fa-solid fa-shield-halved"></i></div>
      <div class="af-security-title">Payment Tips</div>
    </div>
    <ul class="af-tips-list">
      <li><i class="fa-solid fa-circle-check"></i> Send the exact amount</li>
      <li><i class="fa-solid fa-circle-check"></i> Upload a clear screenshot</li>
      <li><i class="fa-solid fa-circle-check"></i> Don't edit the screenshot</li>
      <li><i class="fa-solid fa-circle-check"></i> Wait for approval</li>
      <li><i class="fa-solid fa-circle-check"></i> Contact support if delayed</li>
    </ul>
  </div>

  <!-- ===================== RECENT FUND REQUESTS ===================== -->
  <div class="af-card">
    <h2 class="af-card-title">Recent Fund Requests</h2>
    <div class="af-table-wrap">
      <table class="af-table">
        <thead>
          <tr>
            <th>Amount</th>
            <th>Status</th>
            <th>Admin Note</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% if (recent.length === 0) { %>
            <tr>
              <td colspan="4" class="af-table-empty">
                <div class="af-empty-illustration">
                  <div class="af-empty-icon"><i class="fa-regular fa-folder-open"></i></div>
                  <div class="af-empty-title">No Payment Requests Yet</div>
                  <div class="af-empty-sub">Your submitted deposits will show up here.</div>
                </div>
              </td>
            </tr>
          <% } %>
          <% recent.forEach(tx => { %>
            <tr>
              <td><%= settings.currency %> <%= tx.amount.toFixed(2) %></td>
              <td>
                <span class="af-status af-status-<%= tx.status %>"><span class="af-status-icon"></span><%= tx.status %></span>
              </td>
              <td><%= tx.adminNote || '-' %></td>
              <td><%= tx.createdAt.toLocaleString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</div>


<script>
(function () {
  // ---- Copy buttons ----
  document.querySelectorAll('.af-copy-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var value = btn.getAttribute('data-copy');
      if (!value) return;

      var done = function () {
        var label = btn.querySelector('.af-copy-label');
        var original = label ? label.textContent : null;
        btn.classList.add('af-copied');
        if (label) label.textContent = 'Copied Successfully';
        setTimeout(function () {
          btn.classList.remove('af-copied');
          if (label && original) label.textContent = original;
        }, 2000);
      };

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(value).then(done).catch(function () { fallbackCopy(value, done); });
      } else {
        fallbackCopy(value, done);
      }
    });
  });

  function fallbackCopy(text, cb) {
    var el = document.createElement('textarea');
    el.value = text;
    el.style.position = 'fixed';
    el.style.opacity = '0';
    document.body.appendChild(el);
    el.select();
    try { document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(el);
    if (cb) cb();
  }

  // ---- Dropzone / file preview ----
  var dropzone = document.getElementById('dropzone');
  var input = document.getElementById('screenshotInput');
  var empty = document.getElementById('dropzoneEmpty');
  var filled = document.getElementById('dropzoneFilled');
  var preview = document.getElementById('dropzonePreview');
  var filename = document.getElementById('dropzoneFilename');
  var filesize = document.getElementById('dropzoneFilesize');
  var replaceBtn = document.getElementById('replaceBtn');
  var removeBtn = document.getElementById('removeBtn');

  function formatBytes(bytes) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
  }

  if (dropzone && input) {
    dropzone.addEventListener('click', function (e) {
      if (e.target === replaceBtn || (replaceBtn && replaceBtn.contains(e.target))) return;
      if (e.target === removeBtn || (removeBtn && removeBtn.contains(e.target))) return;
      input.click();
    });
    dropzone.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); }
    });

    ['dragover', 'dragenter'].forEach(function (evt) {
      dropzone.addEventListener(evt, function (e) { e.preventDefault(); dropzone.classList.add('af-dragover'); });
    });
    ['dragleave', 'dragend'].forEach(function (evt) {
      dropzone.addEventListener(evt, function () { dropzone.classList.remove('af-dragover'); });
    });
    dropzone.addEventListener('drop', function (e) {
      e.preventDefault();
      dropzone.classList.remove('af-dragover');
      if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length) {
        input.files = e.dataTransfer.files;
        handleFile();
      }
    });

    input.addEventListener('change', handleFile);

    if (replaceBtn) {
      replaceBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        input.click();
      });
    }

    if (removeBtn) {
      removeBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        input.value = '';
        preview.src = '';
        filled.hidden = true;
        empty.hidden = false;
      });
    }
  }

  function handleFile() {
    var file = input.files && input.files[0];
    if (!file) return;
    filename.textContent = file.name;
    if (filesize) filesize.textContent = formatBytes(file.size);
    var reader = new FileReader();
    reader.onload = function (e) { preview.src = e.target.result; };
    reader.readAsDataURL(file);
    empty.hidden = true;
    filled.hidden = false;
  }

  // ---- Prevent double submit ----
  var form = document.getElementById('addFundsForm');
  var submitBtn = document.getElementById('submitBtn');
  var submitting = false;

  if (form && submitBtn) {
    form.addEventListener('submit', function (e) {
      if (submitting) { e.preventDefault(); return; }
      submitting = true;
      submitBtn.disabled = true;
      submitBtn.classList.add('af-loading');
    });
  }
})();
</script>
