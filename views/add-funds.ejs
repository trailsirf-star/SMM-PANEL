<%# ============================================================
    ADD FUNDS — Premium Payment Page
    Dependencies: layout.ejs wraps this; settings, recent locals
    Form: POST /add-funds  enctype=multipart/form-data
    Fields preserved: amount (name="amount"), screenshot (name="screenshot")
    No Transaction ID field — intentionally absent per spec.
    ============================================================ %>

<%# ── Page-scoped CSS ─────────────────────────────────────── %>
<style>
/* ── Page header ── */
.funds-page-header { margin-bottom: 2.5rem; }
.funds-page-header h2 {
  font-size: clamp(1.5rem, 4vw, 2rem);
  font-weight: 800;
  letter-spacing: -0.04em;
  color: var(--text-primary);
  margin-bottom: 0.35rem;
}
.funds-page-header p {
  color: var(--text-secondary);
  font-size: 0.95rem;
  margin: 0;
}

/* ── Payment method cards ── */
.payment-method-card {
  background: #fff;
  border: 1.5px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 1.75rem 1.5rem 1.5rem;
  box-shadow: var(--shadow-sm);
  transition: box-shadow 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.payment-method-card:hover {
  box-shadow: var(--shadow-lg);
  border-color: var(--brand-primary);
  transform: translateY(-2px);
}

/* Logo container — always same fixed height, never raw natural size */
.payment-logo-container {
  display: flex;
  align-items: center;
  height: 52px;
}
.payment-logo-container img {
  height: 48px;
  width: auto;
  max-width: 140px;
  object-fit: contain;
  display: block;
}

.payment-card-body { flex: 1; }

.payment-detail-label {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-muted);
  margin-bottom: 0.2rem;
}
.payment-detail-value {
  font-size: 1.25rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--text-primary);
  word-break: break-all;
}
.payment-detail-name {
  font-size: 0.85rem;
  color: var(--text-secondary);
  margin-top: 0.15rem;
}

.copy-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.8rem;
  font-weight: 600;
  padding: 0.3rem 0.75rem;
  border-radius: 6px;
  border: 1.5px solid var(--border-color);
  background: #fff;
  color: var(--text-secondary);
  cursor: pointer;
  transition: all 0.18s ease;
  white-space: nowrap;
  min-height: 44px;
}
.copy-btn:hover { background: var(--brand-primary-light); border-color: var(--brand-primary); color: var(--brand-primary); }
.copy-btn.copied { background: #d1fae5; border-color: #6ee7b7; color: #065f46; }

.verified-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: #065f46;
  background: #d1fae5;
  border: 1px solid #6ee7b7;
  border-radius: 20px;
  padding: 0.25rem 0.65rem;
}

.easypaisa-accent { border-top: 3px solid #00a651; }
.binance-accent    { border-top: 3px solid #f3ba2f; }

/* ── How to Pay timeline ── */
.how-to-pay { margin: 2.5rem 0; }
.how-to-pay h5 {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  margin-bottom: 1.25rem;
}
.steps-track {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 0;
}
.step-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
}
.step-item:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 18px;
  left: calc(50% + 18px);
  right: calc(-50% + 18px);
  height: 2px;
  background: linear-gradient(90deg, var(--brand-primary) 0%, var(--border-color) 100%);
}
.step-dot {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--brand-primary-light);
  border: 2px solid var(--brand-primary);
  color: var(--brand-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}
.step-label {
  font-size: 0.7rem;
  font-weight: 600;
  color: var(--text-secondary);
  line-height: 1.3;
  padding: 0 0.15rem;
}
/* Mobile: vertical steps */
@media (max-width: 575px) {
  .steps-track {
    flex-direction: column;
    gap: 0;
    align-items: flex-start;
  }
  .step-item {
    flex-direction: row;
    align-items: center;
    text-align: left;
    gap: 0.75rem;
    padding-left: 0;
    flex: none;
    width: 100%;
    padding-bottom: 1rem;
    position: relative;
  }
  .step-item:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 36px;
    left: 17px;
    right: auto;
    width: 2px;
    height: calc(100% - 18px);
    background: linear-gradient(180deg, var(--brand-primary) 0%, var(--border-color) 100%);
  }
  .step-dot { margin-bottom: 0; flex-shrink: 0; }
  .step-label { font-size: 0.78rem; }
}

/* ── Upload zone ── */
.upload-zone {
  border: 2px dashed var(--border-color);
  border-radius: var(--radius-md);
  padding: 2rem 1rem;
  text-align: center;
  cursor: pointer;
  background: #fafbfc;
  transition: all 0.2s ease;
  position: relative;
}
.upload-zone:hover, .upload-zone.dragover {
  border-color: var(--brand-primary);
  background: var(--brand-primary-light);
}
.upload-zone input[type="file"] {
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
  width: 100%;
  height: 100%;
}
.upload-zone-icon {
  font-size: 2.25rem;
  color: var(--text-muted);
  margin-bottom: 0.75rem;
}
.upload-zone-text { font-size: 0.9rem; color: var(--text-secondary); }
.upload-zone-hint { font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem; }

.upload-preview {
  display: none;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  background: var(--brand-primary-light);
  border: 1.5px solid #c7d2fe;
  border-radius: var(--radius-sm);
  margin-top: 0.75rem;
  flex-wrap: wrap;
}
.upload-preview.visible { display: flex; }
.upload-preview-thumb {
  width: 48px;
  height: 48px;
  object-fit: cover;
  border-radius: 6px;
  border: 1px solid #c7d2fe;
  flex-shrink: 0;
}
.upload-preview-info { flex: 1; min-width: 0; }
.upload-preview-name {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--brand-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.upload-preview-size { font-size: 0.72rem; color: var(--text-secondary); margin-top: 0.15rem; }
.upload-preview-remove {
  font-size: 0.75rem;
  font-weight: 600;
  color: #991b1b;
  background: #fee2e2;
  border: none;
  border-radius: 6px;
  padding: 0.25rem 0.6rem;
  cursor: pointer;
  min-height: 44px;
  transition: background 0.15s;
  flex-shrink: 0;
}
.upload-preview-remove:hover { background: #fecaca; }

/* ── Submit button with spinner ── */
.btn-submit-funds {
  background: linear-gradient(135deg, var(--brand-primary) 0%, #6d28d9 100%);
  border: none;
  color: #fff;
  font-size: 1rem;
  font-weight: 700;
  padding: 0.9rem 1.5rem;
  border-radius: var(--radius-sm);
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  box-shadow: 0 4px 14px rgba(79, 70, 229, 0.35);
  transition: all 0.2s ease;
  cursor: pointer;
  min-height: 52px;
}
.btn-submit-funds:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(79, 70, 229, 0.45);
}
.btn-submit-funds:disabled {
  opacity: 0.7;
  cursor: not-allowed;
  transform: none;
}
.btn-submit-funds .spinner-border { width: 1rem; height: 1rem; border-width: 2px; }

/* ── Security / tips cards ── */
.security-notice {
  background: linear-gradient(135deg, #ecfdf5 0%, #f0fdf4 100%);
  border: 1.5px solid #6ee7b7;
  border-radius: var(--radius-md);
  padding: 1.25rem 1.5rem;
}
.security-notice h6 {
  color: #065f46;
  font-weight: 700;
  font-size: 0.85rem;
  margin-bottom: 0.5rem;
}
.security-notice ul {
  margin: 0;
  padding-left: 1.25rem;
  color: #065f46;
  font-size: 0.82rem;
  line-height: 1.7;
}
.tips-card {
  background: #fffbeb;
  border: 1.5px solid #fcd34d;
  border-radius: var(--radius-md);
  padding: 1.25rem 1.5rem;
}
.tips-card h6 {
  color: #92400e;
  font-weight: 700;
  font-size: 0.85rem;
  margin-bottom: 0.5rem;
}
.tips-card ul {
  margin: 0;
  padding-left: 1.25rem;
  color: #78350f;
  font-size: 0.82rem;
  line-height: 1.7;
}

/* ── History table ── */
.funds-history .table-modern thead th { padding: 0.85rem 1rem; }
.funds-history .table-modern tbody td { padding: 0.85rem 1rem; font-size: 0.88rem; }
/* Scroll-hint fade on mobile */
@media (max-width: 575px) {
  .funds-table-wrapper { position: relative; }
  .funds-table-wrapper::after {
    content: '';
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: 32px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.95));
    pointer-events: none;
  }
}

/* ── Amount field ── */
.amount-input-group .input-group-text {
  background: var(--brand-primary-light);
  border-color: var(--border-color);
  color: var(--brand-primary);
  font-weight: 700;
  font-size: 1rem;
  border-right: none;
}
.amount-input-group .form-control {
  border-left: none;
  font-size: 1.1rem;
  font-weight: 600;
}
.amount-input-group .form-control:focus { box-shadow: 0 0 0 3px rgba(79,70,229,0.1); border-color: var(--brand-primary); }
.amount-input-group .form-control:focus + .input-group-text,
.amount-input-group .input-group-text { border-color: inherit; }

/* Min deposit hint */
.min-deposit-hint {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.78rem;
  color: var(--text-muted);
  margin-top: 0.4rem;
}
</style>

<%# ── Page header ─────────────────────────────────────────── %>
<div class="funds-page-header">
  <h2>Add Funds</h2>
  <p>Deposit securely using Easypaisa or Binance. Balance is added after admin approval.</p>
</div>

<%# ── Success / Error banners ─────────────────────────────── %>
<% if (typeof message !== 'undefined' && message) { %>
  <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
    <i class="fa-solid fa-circle-check"></i>
    <span><%= message %></span>
  </div>
<% } %>
<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
    <i class="fa-solid fa-circle-xmark"></i>
    <span><%= error %></span>
  </div>
<% } %>

<%# ── Payment method cards ─────────────────────────────────── %>
<div class="row g-3 mb-4">
  <%# — Easypaisa card — %>
  <div class="col-sm-6">
    <div class="payment-method-card easypaisa-accent">
      <div class="d-flex align-items-start justify-content-between gap-2 flex-wrap">
        <div class="payment-logo-container">
          <img src="/img/easypaisa-logo.png"
               alt="Easypaisa"
               onerror="this.onerror=null;this.style.display='none';this.parentNode.querySelector('.logo-fallback').style.display='flex'">
          <span class="logo-fallback align-items-center gap-2" style="display:none;font-size:1.1rem;font-weight:800;color:#00a651;">
            <i class="fa-solid fa-mobile-screen"></i> Easypaisa
          </span>
        </div>
        <span class="verified-badge"><i class="fa-solid fa-shield-check"></i> Verified</span>
      </div>

      <div class="payment-card-body">
        <div class="mb-2">
          <div class="payment-detail-label">Account Name</div>
          <div class="payment-detail-name fw-semibold"><%= settings.easypaisaAccountName || 'Not configured' %></div>
        </div>
        <div>
          <div class="payment-detail-label">Easypaisa Number</div>
          <div class="d-flex align-items-center gap-2 flex-wrap mt-1">
            <span class="payment-detail-value" id="ep-number"><%= settings.easypaisaNumber || 'Not configured' %></span>
            <button type="button" class="copy-btn" onclick="copyText('ep-number', this)" aria-label="Copy Easypaisa number">
              <i class="fa-regular fa-copy"></i> Copy
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# — Binance card — %>
  <div class="col-sm-6">
    <div class="payment-method-card binance-accent">
      <div class="d-flex align-items-start justify-content-between gap-2 flex-wrap">
        <div class="payment-logo-container">
          <img src="/img/binance-logo.png"
               alt="Binance Pay"
               onerror="this.onerror=null;this.style.display='none';this.parentNode.querySelector('.logo-fallback').style.display='flex'">
          <span class="logo-fallback align-items-center gap-2" style="display:none;font-size:1.1rem;font-weight:800;color:#f3ba2f;">
            <i class="fa-solid fa-circle-dollar-to-slot"></i> Binance Pay
          </span>
        </div>
        <span class="verified-badge"><i class="fa-solid fa-shield-check"></i> Verified</span>
      </div>

      <div class="payment-card-body">
        <div class="mb-2">
          <div class="payment-detail-label"><%= (settings.binancePayLabel && settings.binancePayLabel.trim()) ? settings.binancePayLabel : 'Binance Pay ID' %></div>
          <div class="payment-detail-name fw-semibold">Binance Pay</div>
        </div>
        <div>
          <div class="payment-detail-label">Binance ID / UID</div>
          <div class="d-flex align-items-center gap-2 flex-wrap mt-1">
            <span class="payment-detail-value" id="bn-id"><%= (settings.binanceId && settings.binanceId.trim()) ? settings.binanceId : 'Not configured' %></span>
            <% if (settings.binanceId && settings.binanceId.trim()) { %>
            <button type="button" class="copy-btn" onclick="copyText('bn-id', this)" aria-label="Copy Binance ID">
              <i class="fa-regular fa-copy"></i> Copy
            </button>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%# ── How to Pay timeline ─────────────────────────────────── %>
<div class="how-to-pay">
  <h5>How to Pay</h5>
  <div class="steps-track">
    <div class="step-item">
      <div class="step-dot"><i class="fa-solid fa-hand-pointer" style="font-size:0.7rem"></i></div>
      <div class="step-label">Choose<br>method</div>
    </div>
    <div class="step-item">
      <div class="step-dot"><i class="fa-solid fa-paper-plane" style="font-size:0.7rem"></i></div>
      <div class="step-label">Send<br>payment</div>
    </div>
    <div class="step-item">
      <div class="step-dot"><i class="fa-solid fa-camera" style="font-size:0.7rem"></i></div>
      <div class="step-label">Take<br>screenshot</div>
    </div>
    <div class="step-item">
      <div class="step-dot"><i class="fa-solid fa-upload" style="font-size:0.7rem"></i></div>
      <div class="step-label">Upload<br>below</div>
    </div>
    <div class="step-item">
      <div class="step-dot"><i class="fa-solid fa-paper-plane" style="font-size:0.7rem"></i></div>
      <div class="step-label">Submit<br>form</div>
    </div>
    <div class="step-item">
      <div class="step-dot"><i class="fa-solid fa-user-check" style="font-size:0.7rem"></i></div>
      <div class="step-label">Admin<br>verifies</div>
    </div>
    <div class="step-item">
      <div class="step-dot"><i class="fa-solid fa-wallet" style="font-size:0.7rem"></i></div>
      <div class="step-label">Balance<br>added</div>
    </div>
  </div>
</div>

<%# ── Main form + sidebar ─────────────────────────────────── %>
<div class="row g-4">
  <%# — Form column — %>
  <div class="col-lg-7">
    <div class="card border-0" style="border-radius:var(--radius-lg)!important; box-shadow:var(--shadow-md);">
      <div class="card-header" style="padding:1.25rem 1.5rem; border-bottom:1px solid var(--border-color);">
        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-upload text-primary me-2"></i>Submit Payment</h6>
      </div>
      <div class="card-body p-4">
        <form method="POST" action="/add-funds" enctype="multipart/form-data" id="add-funds-form" novalidate>

          <%# Amount %>
          <div class="mb-4">
            <label for="amountInput" class="form-label">Amount</label>
            <div class="input-group amount-input-group">
              <span class="input-group-text"><%= settings.currency %></span>
              <input
                type="number"
                id="amountInput"
                name="amount"
                min="<%= settings.minimumDeposit %>"
                step="0.01"
                class="form-control"
                placeholder="0.00"
                required
                autocomplete="off"
              >
            </div>
            <div class="min-deposit-hint">
              <i class="fa-solid fa-circle-info"></i>
              Minimum deposit: <%= settings.currency %> <%= settings.minimumDeposit %>
            </div>
          </div>

          <%# Screenshot upload zone %>
          <div class="mb-4">
            <label class="form-label">Payment Screenshot</label>
            <div class="upload-zone" id="upload-zone" tabindex="0" role="button" aria-label="Click or drag to upload payment screenshot">
              <%# Real file input — name="screenshot" must stay exactly as-is for fundsController %>
              <input
                type="file"
                name="screenshot"
                id="screenshotInput"
                accept="image/png,image/jpeg,image/webp"
                required
                tabindex="-1"
                aria-hidden="true"
              >
              <div class="upload-zone-icon" id="upload-icon">
                <i class="fa-solid fa-cloud-arrow-up"></i>
              </div>
              <div class="upload-zone-text" id="upload-text">
                <strong>Click to browse</strong> or drag & drop
              </div>
              <div class="upload-zone-hint" id="upload-hint">PNG, JPG, WEBP — full screenshot, not cropped</div>
            </div>

            <%# Preview strip — hidden until file selected %>
            <div class="upload-preview" id="upload-preview" aria-live="polite">
              <img class="upload-preview-thumb" id="preview-thumb" src="" alt="Preview">
              <div class="upload-preview-info">
                <div class="upload-preview-name" id="preview-name"></div>
                <div class="upload-preview-size" id="preview-size"></div>
              </div>
              <button type="button" class="upload-preview-remove" id="remove-file" aria-label="Remove selected file">
                <i class="fa-solid fa-trash-can"></i> Remove
              </button>
            </div>
          </div>

          <%# Submit %>
          <button type="submit" class="btn-submit-funds" id="submit-btn">
            <i class="fa-solid fa-lock me-1"></i>
            <span id="btn-label">Submit for Review</span>
            <span class="spinner-border d-none" id="btn-spinner" role="status" aria-hidden="true"></span>
          </button>

        </form>
      </div>
    </div>
  </div>

  <%# — Sidebar column — %>
  <div class="col-lg-5">
    <%# Security notice %>
    <div class="security-notice mb-3">
      <h6><i class="fa-solid fa-shield-halved me-2"></i>Secure & Verified</h6>
      <ul>
        <li>All payments are <strong>manually verified</strong> by our team</li>
        <li>Balance is credited after admin approval</li>
        <li>Upload a <strong>clear, unedited screenshot</strong></li>
        <li>Fake or edited screenshots are <strong>immediately rejected</strong></li>
      </ul>
    </div>

    <%# Tips %>
    <div class="tips-card">
      <h6><i class="fa-solid fa-lightbulb me-2"></i>Tips for fast approval</h6>
      <ul>
        <li>Double-check the account number before sending</li>
        <li>Use your own account — third-party payments may be rejected</li>
        <li>Upload the <strong>full screenshot</strong>, don't crop the proof</li>
        <li>Include the payment confirmation screen, not just the receipt</li>
      </ul>
    </div>
  </div>
</div>

<%# ── Recent Fund Requests history ────────────────────────── %>
<div class="card border-0 mt-4 funds-history" style="border-radius:var(--radius-lg)!important; box-shadow:var(--shadow-sm);">
  <div class="card-header d-flex align-items-center justify-content-between" style="padding:1rem 1.5rem; border-bottom:1px solid var(--border-color);">
    <span class="fw-bold" style="font-size:0.95rem;">
      <i class="fa-solid fa-clock-rotate-left text-muted me-2"></i>Recent Fund Requests
    </span>
    <% if (recent.length > 0) { %>
      <span class="badge bg-light text-muted border" style="font-size:0.7rem;"><%= recent.length %> requests</span>
    <% } %>
  </div>
  <div class="funds-table-wrapper table-responsive">
    <table class="table table-modern mb-0 align-middle">
      <thead>
        <tr>
          <th>Amount</th>
          <th>Status</th>
          <th>Admin Note</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody>
        <% if (recent.length === 0) { %>
          <tr>
            <td colspan="4" class="text-center py-5">
              <div style="color:var(--text-muted);font-size:0.9rem;">
                <i class="fa-regular fa-folder-open d-block mb-2" style="font-size:1.5rem;"></i>
                No fund requests yet
              </div>
            </td>
          </tr>
        <% } %>
        <% recent.forEach(tx => { %>
          <tr>
            <td>
              <span style="font-weight:700;"><%= settings.currency %> <%= tx.amount.toFixed(2) %></span>
            </td>
            <td>
              <span class="status-badge <%= tx.status === 'approved' ? 'status-completed' : tx.status === 'rejected' ? 'status-cancelled' : 'status-pending' %>">
                <span class="status-dot"></span>
                <%= tx.status.charAt(0).toUpperCase() + tx.status.slice(1) %>
              </span>
            </td>
            <td style="color:var(--text-secondary);font-size:0.85rem;"><%= tx.adminNote || '—' %></td>
            <td style="color:var(--text-muted);font-size:0.8rem;white-space:nowrap;"><%= tx.createdAt.toLocaleString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%# ── Page-scoped JS ──────────────────────────────────────── %>
<script>
(function () {
  'use strict';

  /* ── Copy to clipboard ── */
  window.copyText = function (elementId, btn) {
    const el = document.getElementById(elementId);
    if (!el) return;
    const text = el.textContent.trim();
    if (!text || text === 'Not configured') return;

    navigator.clipboard.writeText(text).then(() => {
      btn.classList.add('copied');
      btn.innerHTML = '<i class="fa-solid fa-check"></i> Copied!';
      setTimeout(() => {
        btn.classList.remove('copied');
        btn.innerHTML = '<i class="fa-regular fa-copy"></i> Copy';
      }, 2200);
    }).catch(() => {
      // Fallback for older browsers
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.cssText = 'position:fixed;opacity:0;pointer-events:none';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      btn.classList.add('copied');
      btn.innerHTML = '<i class="fa-solid fa-check"></i> Copied!';
      setTimeout(() => {
        btn.classList.remove('copied');
        btn.innerHTML = '<i class="fa-regular fa-copy"></i> Copy';
      }, 2200);
    });
  };

  /* ── Upload zone drag-and-drop + preview ── */
  const zone    = document.getElementById('upload-zone');
  const input   = document.getElementById('screenshotInput');
  const preview = document.getElementById('upload-preview');
  const thumb   = document.getElementById('preview-thumb');
  const nameEl  = document.getElementById('preview-name');
  const sizeEl  = document.getElementById('preview-size');
  const removeBtn = document.getElementById('remove-file');
  const icon    = document.getElementById('upload-icon');
  const text    = document.getElementById('upload-text');
  const hint    = document.getElementById('upload-hint');

  function formatBytes(bytes) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / 1048576).toFixed(1) + ' MB';
  }

  function showPreview(file) {
    if (!file) return;
    nameEl.textContent = file.name;
    sizeEl.textContent = formatBytes(file.size);
    const reader = new FileReader();
    reader.onload = e => { thumb.src = e.target.result; };
    reader.readAsDataURL(file);
    preview.classList.add('visible');
    // Dim zone content when a file is chosen
    icon.style.opacity = '0.35';
    text.style.opacity = '0.35';
    hint.style.opacity = '0.35';
  }

  function clearPreview() {
    preview.classList.remove('visible');
    thumb.src = '';
    nameEl.textContent = '';
    sizeEl.textContent = '';
    icon.style.opacity = '';
    text.style.opacity = '';
    hint.style.opacity = '';
    // Clear the file input value
    input.value = '';
  }

  input.addEventListener('change', () => {
    if (input.files && input.files[0]) showPreview(input.files[0]);
    else clearPreview();
  });

  removeBtn.addEventListener('click', clearPreview);

  // Drag & drop
  zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('dragover'); });
  zone.addEventListener('dragleave', () => zone.classList.remove('dragover'));
  zone.addEventListener('drop', e => {
    e.preventDefault();
    zone.classList.remove('dragover');
    const file = e.dataTransfer.files[0];
    if (file && ['image/png', 'image/jpeg', 'image/webp'].includes(file.type)) {
      // Create a new DataTransfer to assign to the input
      const dt = new DataTransfer();
      dt.items.add(file);
      input.files = dt.files;
      showPreview(file);
    }
  });

  // Keyboard activation for upload zone
  zone.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); }
  });

  /* ── Form submit: spinner + disable ── */
  const form      = document.getElementById('add-funds-form');
  const submitBtn = document.getElementById('submit-btn');
  const btnLabel  = document.getElementById('btn-label');
  const btnSpinner = document.getElementById('btn-spinner');

  // Re-enable button if we landed here via back-navigation (e.g. after error redirect)
  window.addEventListener('pageshow', () => {
    submitBtn.disabled = false;
    btnLabel.textContent = 'Submit for Review';
    btnSpinner.classList.add('d-none');
  });

  form.addEventListener('submit', () => {
    submitBtn.disabled = true;
    btnLabel.textContent = 'Submitting…';
    btnSpinner.classList.remove('d-none');
  });
})();
</script>
