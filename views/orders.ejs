<h3 class="fw-bold mb-4">My Orders</h3>

<div class="card shadow-sm border-0">
  <div class="table-responsive">
    <table class="table mb-0 align-middle">
      <thead class="table-light">
        <tr>
          <th>Order ID</th>
          <th>Service</th>
          <th>Link</th>
          <th>Quantity</th>
          <th>Charge</th>
          <th>Start Count</th>
          <th>Remains</th>
          <th>Status</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody id="ordersTableBody">
        <% if (orders.length === 0) { %>
          <tr><td colspan="9" class="text-center text-muted py-4">No orders yet. <a href="/orders/new">Place your first order</a>.</td></tr>
        <% } %>
        <% orders.forEach(order => { %>
          <tr data-order-id="<%= order._id %>">
            <td class="text-muted small">#<%= order._id.toString().slice(-6) %></td>
            <td><%= order.service ? order.service.name : 'Deleted Service' %></td>
            <td class="text-truncate d-inline-block" style="max-width: 180px;"><%= order.link %></td>
            <td><%= order.quantity %></td>
            <td>Rs. <%= order.charge.toFixed(2) %></td>
            <td class="js-start-count"><%= order.startCount %></td>
            <td class="js-remains"><%= order.remains %></td>
            <td>
              <span class="badge status-badge js-status status-<%= order.status.replace(' ', '-') %>">
                <%= order.status %>
              </span>
            </td>
            <td><%= order.createdAt.toLocaleString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script>
  // Poll /api/orders/status every few seconds and update badges/columns
  // in place, without a full page reload.
  async function pollOrderStatuses() {
    try {
      const res = await fetch('/api/orders/status');
      const data = await res.json();
      if (!data.success) return;

      data.orders.forEach(order => {
        const row = document.querySelector(`tr[data-order-id="${order._id}"]`);
        if (!row) return;

        const statusEl = row.querySelector('.js-status');
        const remainsEl = row.querySelector('.js-remains');
        const startEl = row.querySelector('.js-start-count');

        if (statusEl) {
          statusEl.textContent = order.status;
          statusEl.className = 'badge status-badge js-status status-' + order.status.replace(' ', '-');
        }
        if (remainsEl) remainsEl.textContent = order.remains;
        if (startEl) startEl.textContent = order.startCount;
      });
    } catch (err) {
      // Silent fail — next poll will retry.
    }
  }

  pollOrderStatuses();
  setInterval(pollOrderStatuses, 5000);
</script>
