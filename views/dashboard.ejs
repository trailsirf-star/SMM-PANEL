<style>
  /* Icon badges — same palette as the admin dashboard, kept page-scoped */
  .stat-icon {
    width: 44px; height: 44px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.05rem; flex-shrink: 0;
  }
  .bg-indigo-50 { background-color: #eef2ff; } .text-indigo-600 { color: #4f46e5; }
  .bg-blue-50   { background-color: #eff6ff; } .text-blue-600   { color: #2563eb; }
  .bg-purple-50 { background-color: #faf5ff; } .text-purple-600 { color: #9333ea; }
  .bg-green-50  { background-color: #ecfdf5; } .text-green-600  { color: #059669; }

  .dash-section-label {
    font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--text-muted); margin-bottom: 0.75rem;
  }
</style>

<div class="page-header mb-4">
  <h3 class="fw-bold mb-1">Welcome back, <%= user.name %> 👋</h3>
  <p class="text-muted mb-0">Here's what's happening with your account.</p>
</div>

<div class="dash-section-label">Account Overview</div>
<div class="row g-3 mb-4 stat-cards-row">
  <div class="col-xl-3 col-lg-3 col-md-6 col-6">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <span class="stat-icon bg-green-50 text-green-600"><i class="fa-solid fa-wallet"></i></span>
        </div>
        <div class="stat-card-label">Wallet Balance</div>
        <div class="stat-card-value"><%= settings.currency %> <%= user.balance.toFixed(2) %></div>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-lg-3 col-md-6 col-6">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <span class="stat-icon bg-indigo-50 text-indigo-600"><i class="fa-solid fa-cart-shopping"></i></span>
        </div>
        <div class="stat-card-label">Total Orders</div>
        <div class="stat-card-value"><%= totalOrders %></div>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-lg-3 col-md-6 col-6">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <span class="stat-icon bg-blue-50 text-blue-600"><i class="fa-solid fa-circle-check"></i></span>
        </div>
        <div class="stat-card-label">Completed Orders</div>
        <div class="stat-card-value"><%= completedOrders %></div>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-lg-3 col-md-6 col-6">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <span class="stat-icon bg-purple-50 text-purple-600"><i class="fa-solid fa-chart-line"></i></span>
        </div>
        <div class="stat-card-label">Total Spent</div>
        <div class="stat-card-value"><%= settings.currency %> <%= totalSpent.toFixed(2) %></div>
      </div>
    </div>
  </div>
</div>

<div class="dash-section-label">Quick Actions</div>
<div class="row g-3 mb-4 quick-actions-row">
  <div class="col-md-4">
    <a href="/orders/new" class="quick-action-card">
      <span class="quick-action-icon bg-indigo-50 text-indigo-600"><i class="fa-solid fa-cart-plus"></i></span>
      <div>
        <div class="fw-semibold">Place New Order</div>
        <div class="text-muted small">Start a new service order</div>
      </div>
    </a>
  </div>
  <div class="col-md-4">
    <a href="/add-funds" class="quick-action-card">
      <span class="quick-action-icon bg-green-50 text-green-600"><i class="fa-solid fa-wallet"></i></span>
      <div>
        <div class="fw-semibold">Add Funds</div>
        <div class="text-muted small">Easypaisa or Binance Pay</div>
      </div>
    </a>
  </div>
  <div class="col-md-4">
    <a href="/services" class="quick-action-card">
      <span class="quick-action-icon bg-blue-50 text-blue-600"><i class="fa-solid fa-list"></i></span>
      <div>
        <div class="fw-semibold">Browse Services</div>
        <div class="text-muted small">See prices & categories</div>
      </div>
    </a>
  </div>
</div>

<div class="card shadow-sm border-0">
  <div class="card-header bg-white d-flex justify-content-between align-items-center">
    <span class="fw-semibold"><i class="fa-solid fa-clock-rotate-left text-muted me-2"></i>Recent Orders</span>
    <a href="/orders" class="btn btn-sm btn-light" style="border: 1px solid var(--border-color);">View All</a>
  </div>
  <div class="table-responsive">
    <table class="table table-modern mb-0 align-middle">
      <thead>
        <tr>
          <th>Service</th>
          <th>Link</th>
          <th>Qty</th>
          <th>Charge</th>
          <th>Status</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody>
        <% if (recentOrders.length === 0) { %>
          <tr>
            <td colspan="6" class="text-center text-muted py-5">
              <i class="fa-solid fa-inbox fa-2x mb-3 opacity-25 d-block"></i>
              <div class="fw-semibold text-dark mb-1">No orders yet</div>
              <div class="small">Ready when you are — <a href="/orders/new">place your first order</a>.</div>
            </td>
          </tr>
        <% } %>
        <% recentOrders.forEach(order => { %>
          <tr>
            <td><%= order.service ? order.service.name : 'Deleted Service' %></td>
            <td class="text-truncate" style="max-width: 200px;"><%= order.link %></td>
            <td><%= order.quantity %></td>
            <td><%= settings.currency %> <%= order.charge.toFixed(2) %></td>
            <td><span class="badge status-badge status-<%= order.status.replace(' ', '-') %>"><%= order.status %></span></td>
            <td><%= order.createdAt.toLocaleDateString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
