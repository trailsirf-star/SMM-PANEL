<h3 class="fw-bold mb-4">Our Services</h3>

<% const categories = Object.keys(grouped); %>

<% if (categories.length === 0) { %>
  <div class="alert alert-info">No services available at the moment. Please check back soon.</div>
<% } %>

<% categories.forEach(category => { %>
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white fw-semibold">
      <i class="fa-solid fa-tag"></i> <%= category %>
    </div>
    <div class="table-responsive">
      <table class="table mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th>ID</th>
            <th>Service Name</th>
            <th>Rate per 1000</th>
            <th>Min</th>
            <th>Max</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% grouped[category].forEach(service => { %>
            <tr>
              <td class="text-muted small">#<%= service._id.toString().slice(-6) %></td>
              <td>
                <%= service.name %>
                <% if (service.description) { %>
                  <div class="text-muted small"><%= service.description %></div>
                <% } %>
              </td>
              <td><%= settings.currency %> <%= service.sellPricePer1000.toFixed(2) %></td>
              <td><%= service.minOrder %></td>
              <td><%= service.maxOrder %></td>
              <td>
                <a href="/orders/new?service=<%= service._id %>" class="btn btn-sm btn-primary">Order Now</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% }) %>
