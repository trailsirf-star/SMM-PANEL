<h3 class="fw-bold mb-4">Manage Services</h3>

<div class="alert alert-light border d-flex justify-content-between align-items-center mb-4">
  <span>
    <i class="fa-solid fa-percent text-primary"></i>
    Your current commission is <strong><%= settings.commissionPercent %>%</strong> over provider cost
    (edit it on the <a href="/admin/settings">Settings page</a>).
  </span>
  <button class="btn btn-sm btn-outline-primary" id="applyCommissionBtn">
    Apply <%= settings.commissionPercent %>% to All Services
  </button>
</div>

<div id="commissionResult"></div>

<div class="row g-4 mb-4">
  <div class="col-md-6">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body p-4">
        <h6 class="fw-semibold mb-3">Add New Service Manually</h6>
        <form method="POST" action="/admin/services">
          <div class="row g-2">
            <div class="col-md-6">
              <input type="text" name="name" class="form-control" placeholder="Service Name" required>
            </div>
            <div class="col-md-6">
              <input type="text" name="category" class="form-control" placeholder="Category (e.g. Instagram)" required>
            </div>
            <div class="col-md-6">
              <input type="text" name="providerServiceId" class="form-control" placeholder="Provider Service ID" required>
            </div>
            <div class="col-md-6">
              <select name="providerId" class="form-select">
                <option value="">No Provider (manual)</option>
                <% providers.forEach(p => { %>
                  <option value="<%= p._id %>"><%= p.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <input type="number" step="0.01" name="providerCostPer1000" class="form-control" placeholder="Provider Cost / 1000" required>
            </div>
            <div class="col-md-6">
              <input type="number" step="0.01" name="sellPricePer1000" class="form-control" placeholder="Sell Price / 1000" required>
            </div>
            <div class="col-md-6">
              <input type="number" name="minOrder" class="form-control" placeholder="Min Order" required>
            </div>
            <div class="col-md-6">
              <input type="number" name="maxOrder" class="form-control" placeholder="Max Order" required>
            </div>
            <div class="col-12">
              <textarea name="description" class="form-control" placeholder="Description (optional)"></textarea>
            </div>
            <div class="col-12">
              <button type="submit" class="btn btn-primary w-100">Add Service</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body p-4">
        <h6 class="fw-semibold mb-3">Import Services From Provider</h6>
        <p class="text-muted small">
          Pulls the full service list from a connected provider and imports any new ones
          as <strong>disabled</strong> (with a default 30% markup) so you can review pricing before enabling them.
        </p>
        <% if (providers.length === 0) { %>
          <div class="alert alert-info">No API providers configured yet. <a href="/admin/api-providers">Add one first</a>.</div>
        <% } %>
        <% providers.forEach(p => { %>
          <div class="d-flex justify-content-between align-items-center border rounded p-2 mb-2">
            <span><%= p.name %></span>
            <button class="btn btn-sm btn-outline-primary js-import-btn" data-id="<%= p._id %>">Import Services</button>
          </div>
        <% }) %>
        <div id="importResult"></div>
      </div>
    </div>
  </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
  <div>
    <button class="btn btn-sm btn-success" id="enableAllBtn">Enable All Disabled Services</button>
    <button class="btn btn-sm btn-outline-success" id="enableSelectedBtn">Enable Selected</button>
    <button class="btn btn-sm btn-outline-secondary" id="disableSelectedBtn">Disable Selected</button>
  </div>
  <div id="bulkResult" class="small"></div>
</div>

<div class="card shadow-sm border-0">
  <div class="table-responsive">
    <table class="table mb-0 align-middle">
      <thead class="table-light">
        <tr>
          <th><input type="checkbox" id="selectAllCheckbox"></th>
          <th>Name</th>
          <th>Category</th>
          <th>Provider</th>
          <th>Cost/1000</th>
          <th>Sell/1000</th>
          <th>Min</th>
          <th>Max</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (services.length === 0) { %>
          <tr><td colspan="10" class="text-center text-muted py-4">No services yet.</td></tr>
        <% } %>
        <% services.forEach(s => { %>
          <tr data-service-id="<%= s._id %>">
            <td><input type="checkbox" class="js-row-checkbox"></td>
            <td><%= s.name %></td>
            <td><%= s.category %></td>
            <td><%= s.provider ? s.provider.name : 'Manual' %></td>
            <td><%= s.providerCostPer1000.toFixed(2) %></td>
            <td>
              <input type="number" step="0.01" class="form-control form-control-sm js-sell-price" style="width:100px" value="<%= s.sellPricePer1000.toFixed(2) %>">
            </td>
            <td><%= s.minOrder %></td>
            <td><%= s.maxOrder %></td>
            <td>
              <select class="form-select form-select-sm js-status-select" style="width:110px">
                <option value="active" <%= s.status === 'active' ? 'selected' : '' %>>Active</option>
                <option value="disabled" <%= s.status === 'disabled' ? 'selected' : '' %>>Disabled</option>
              </select>
            </td>
            <td class="text-nowrap">
              <button class="btn btn-sm btn-outline-success js-save-btn">Save</button>
              <button class="btn btn-sm btn-outline-danger js-delete-btn">Delete</button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script>
  document.getElementById('applyCommissionBtn').addEventListener('click', async () => {
    if (!confirm('This will recalculate the sell price for EVERY service using your current commission %. Continue?')) return;

    const btn = document.getElementById('applyCommissionBtn');
    btn.disabled = true;
    btn.textContent = 'Applying...';

    try {
      const res = await fetch('/admin/services/apply-commission', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({}), // omit serviceIds to apply to all
      });
      const data = await res.json();

      const resultDiv = document.getElementById('commissionResult');
      if (data.success) {
        resultDiv.innerHTML = `<div class="alert alert-success">Updated ${data.updated} service(s) to ${data.commissionPercent}% commission. Reloading...</div>`;
        setTimeout(() => window.location.reload(), 1000);
      } else {
        resultDiv.innerHTML = `<div class="alert alert-danger">${data.error}</div>`;
        btn.disabled = false;
        btn.textContent = 'Apply Commission to All Services';
      }
    } catch (err) {
      alert('Network error while applying commission.');
      btn.disabled = false;
    }
  });

  document.querySelectorAll('.js-import-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      btn.textContent = 'Importing...';
      try {
        const res = await fetch(`/admin/services/import/${btn.dataset.id}`, { method: 'POST' });
        const data = await res.json();
        const resultDiv = document.getElementById('importResult');
        if (data.success) {
          resultDiv.innerHTML = `<div class="alert alert-success mt-2">Imported ${data.imported} new service(s). Reloading...</div>`;
          setTimeout(() => window.location.reload(), 1200);
        } else {
          resultDiv.innerHTML = `<div class="alert alert-danger mt-2">${data.error}</div>`;
        }
      } catch (err) {
        alert('Network error during import.');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Import Services';
      }
    });
  });

  document.querySelectorAll('.js-save-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const row = btn.closest('tr');
      const id = row.dataset.serviceId;
      const sellPricePer1000 = row.querySelector('.js-sell-price').value;
      const status = row.querySelector('.js-status-select').value;

      const res = await fetch(`/admin/services/${id}/update`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sellPricePer1000, status }),
      });
      const data = await res.json();
      if (data.success) {
        btn.textContent = 'Saved!';
        setTimeout(() => (btn.textContent = 'Save'), 1200);
      } else {
        alert(data.error || 'Failed to update.');
      }
    });
  });

  document.querySelectorAll('.js-delete-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('Delete this service permanently?')) return;
      const row = btn.closest('tr');
      const id = row.dataset.serviceId;
      const res = await fetch(`/admin/services/${id}/delete`, { method: 'POST' });
      const data = await res.json();
      if (data.success) row.remove();
      else alert(data.error || 'Failed to delete.');
    });
  });

  // ---------- Bulk status actions ----------
  const selectAllCheckbox = document.getElementById('selectAllCheckbox');
  if (selectAllCheckbox) {
    selectAllCheckbox.addEventListener('change', () => {
      document.querySelectorAll('.js-row-checkbox').forEach(cb => (cb.checked = selectAllCheckbox.checked));
    });
  }

  function getSelectedServiceIds() {
    return Array.from(document.querySelectorAll('.js-row-checkbox:checked')).map(
      cb => cb.closest('tr').dataset.serviceId
    );
  }

  async function bulkSetStatus({ status, all = false, serviceIds = [] }) {
    const bulkResult = document.getElementById('bulkResult');
    try {
      const res = await fetch('/admin/services/bulk-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(all ? { status, all: true } : { status, serviceIds }),
      });
      const data = await res.json();
      if (data.success) {
        bulkResult.innerHTML = `<span class="text-success">Updated ${data.updated} service(s). Reloading...</span>`;
        setTimeout(() => window.location.reload(), 900);
      } else {
        bulkResult.innerHTML = `<span class="text-danger">${data.error}</span>`;
      }
    } catch (err) {
      bulkResult.innerHTML = `<span class="text-danger">Network error updating services.</span>`;
    }
  }

  document.getElementById('enableAllBtn').addEventListener('click', () => {
    if (!confirm('Set EVERY service (across all providers) to Active?')) return;
    bulkSetStatus({ status: 'active', all: true });
  });

  document.getElementById('enableSelectedBtn').addEventListener('click', () => {
    const ids = getSelectedServiceIds();
    if (ids.length === 0) return alert('Select at least one service first.');
    bulkSetStatus({ status: 'active', serviceIds: ids });
  });

  document.getElementById('disableSelectedBtn').addEventListener('click', () => {
    const ids = getSelectedServiceIds();
    if (ids.length === 0) return alert('Select at least one service first.');
    bulkSetStatus({ status: 'disabled', serviceIds: ids });
  });
</script>
