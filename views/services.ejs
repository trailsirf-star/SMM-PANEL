<h3 class="fw-bold mb-4">Our Services</h3>

<% const categories = Object.keys(grouped); %>
<% if (categories.length === 0) { %>
  <div class="alert alert-info">
    No services available at the moment. Please check back soon.
  </div>
<% } else { %>
  <% categories.forEach(category => { %>
    <div class="mb-5">
      <h5 class="fw-semibold mb-3"><%= category %></h5>
      <div class="card shadow-sm border-0">
        <div class="table-responsive">
          <table class="table mb-0 align-middle">
            <thead class="table-light">
              <tr>
                <th>Service</th>
                <th>Description</th>
                <th>Min</th>
                <th>Max</th>
                <th>Rate / 1000 (<%= settings.currency %>)</th>
                <th class="text-end"></th>
              </tr>
            </thead>
            <tbody>
              <% grouped[category].forEach(s => { %>
                <tr>
                  <td><%= s.name %></td>
                  <td class="text-muted small"><%= s.description || '—' %></td>
                  <td><%= s.minOrder %></td>
                  <td><%= s.maxOrder %></td>
                  <td><%= s.sellPricePer1000.toFixed(2) %></td>
                  <td class="text-end">
                    <a href="/orders/new" class="btn btn-sm btn-primary">Order Now</a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% }) %>
<% } %>
