<h3 class="fw-bold mb-4">API Providers</h3>

<div class="card shadow-sm border-0 mb-4">
  <div class="card-body p-4">
    <h6 class="fw-semibold mb-3">Add New Provider</h6>
    <form method="POST" action="/admin/api-providers" class="row g-2">
      <div class="col-md-3">
        <input type="text" name="name" class="form-control" placeholder="Provider Name" required>
      </div>
      <div class="col-md-4">
        <input type="url" name="apiUrl" class="form-control" placeholder="https://provider.com/api/v2" required>
      </div>
      <div class="col-md-3">
        <input type="text" name="apiKey" class="form-control" placeholder="API Key" required>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Add</button>
      </div>
    </form>
  </div>
</div>

<div class="card shadow-sm border-0">
  <div class="table-responsive">
    <table class="table mb-0 align-middle">
      <thead class="table-light">
        <tr>
          <th>Name</th>
          <th>API URL</th>
          <th>Balance</th>
          <th>Last Synced</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (providers.length === 0) { %>
          <tr><td colspan="6" class="text-center text-muted py-4">No providers added yet.</td></tr>
        <% } %>
        <% providers.forEach(p => { %>
          <tr data-provider-id="<%= p._id %>">
            <td><%= p.name %></td>
            <td class="text-truncate d-inline-block" style="max-width: 250px;"><%= p.apiUrl %></td>
            <td class="js-balance"><%= p.balance.toFixed(2) %> <%= p.currency %></td>
            <td class="js-synced"><%= p.lastSyncedAt ? new Date(p.lastSyncedAt).toLocaleString() : 'Never' %></td>
            <td><span class="badge js-active-badge <%= p.isActive ? 'bg-success' : 'bg-secondary' %>"><%= p.isActive ? 'Active' : 'Inactive' %></span></td>
            <td class="text-nowrap">
              <button class="btn btn-sm btn-outline-primary js-test-btn">Test Connection</button>
              <button class="btn btn-sm btn-outline-secondary js-toggle-btn"><%= p.isActive ? 'Disable' : 'Enable' %></button>
              <button class="btn btn-sm btn-outline-danger js-delete-btn">Delete</button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script>
  document.querySelectorAll('.js-test-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const row = btn.closest('tr');
      const id = row.dataset.providerId;
      btn.disabled = true;
      btn.textContent = 'Testing...';

      try {
        const res = await fetch(`/admin/api-providers/${id}/test`, { method: 'POST' });
        const data = await res.json();

        if (data.success) {
          row.querySelector('.js-balance').textContent = `${data.balance.toFixed(2)} ${data.currency}`;
          row.querySelector('.js-synced').textContent = new Date().toLocaleString();
          alert(`Connection successful! Balance: ${data.balance.toFixed(2)} ${data.currency}`);
        } else {
          alert('Connection failed: ' + data.error);
        }
      } catch (err) {
        alert('Network error while testing connection.');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Test Connection';
      }
    });
  });

  document.querySelectorAll('.js-toggle-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const row = btn.closest('tr');
      const id = row.dataset.providerId;
      const res = await fetch(`/admin/api-providers/${id}/toggle`, { method: 'POST' });
      const data = await res.json();

      if (data.success) {
        row.querySelector('.js-active-badge').textContent = data.isActive ? 'Active' : 'Inactive';
        row.querySelector('.js-active-badge').className = 'badge js-active-badge ' + (data.isActive ? 'bg-success' : 'bg-secondary');
        btn.textContent = data.isActive ? 'Disable' : 'Enable';
      } else {
        alert(data.error || 'Failed to update provider.');
      }
    });
  });

  document.querySelectorAll('.js-delete-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('Delete this provider? Services linked to it will remain but stop syncing.')) return;
      const row = btn.closest('tr');
      const id = row.dataset.providerId;
      const res = await fetch(`/admin/api-providers/${id}/delete`, { method: 'POST' });
      const data = await res.json();
      if (data.success) row.remove();
      else alert(data.error || 'Failed to delete.');
    });
  });
</script>
