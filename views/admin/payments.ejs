<div class="page-header mb-4">
  <h3 class="fw-bold mb-1">Fund Requests</h3>
  <p class="text-muted mb-0">Review and process user manual payment deposits.</p>
</div>

<!-- Premium Tabs -->
<ul class="nav nav-pills gap-2 mb-4" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link active d-flex align-items-center gap-2" data-bs-toggle="tab" data-bs-target="#pendingTab" type="button" role="tab" style="border-radius: 8px; font-weight: 500;">
      <i class="fa-solid fa-clock"></i> Pending
      <% if (pending.length > 0) { %>
        <span class="badge bg-warning text-dark rounded-pill"><%= pending.length %></span>
      <% } %>
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link d-flex align-items-center gap-2" data-bs-toggle="tab" data-bs-target="#historyTab" type="button" role="tab" style="border-radius: 8px; font-weight: 500;">
      <i class="fa-solid fa-history"></i> History
    </button>
  </li>
</ul>

<style>
  .nav-pills .nav-link { color: #64748b; background-color: #f1f5f9; }
  .nav-pills .nav-link.active { background-color: #eef2ff; color: #4f46e5; }
</style>

<div class="tab-content">
  <!-- Pending Tab -->
  <div class="tab-pane fade show active" id="pendingTab" role="tabpanel">
    <div class="card shadow-sm border-0" style="border-radius: 16px; border: 1px solid #e2e8f0; overflow: hidden;">
      <div class="table-responsive">
        <table class="table table-modern align-middle mb-0">
          <thead>
            <tr>
              <th>User</th>
              <th>Amount</th>
              <th>TRX ID</th>
              <th>Screenshot</th>
              <th>Date</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (pending.length === 0) { %>
              <tr>
                <td colspan="6" class="text-center text-muted py-5">
                  <i class="fa-solid fa-check-circle fa-3x mb-3 opacity-25"></i>
                  <h6 class="fw-bold text-dark">All caught up!</h6>
                  <div>No pending fund requests right now.</div>
                </td>
              </tr>
            <% } %>
            <% pending.forEach(tx => { %>
              <tr data-tx-id="<%= tx._id %>">
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <div class="admin-avatar" style="width: 32px; height: 32px; font-size: 0.8rem;">
                      <%= tx.user ? tx.user.name.charAt(0).toUpperCase() : 'D' %>
                    </div>
                    <div>
                      <div class="fw-semibold text-dark"><%= tx.user ? tx.user.name : 'Deleted User' %></div>
                      <div class="small text-muted"><%= tx.user ? tx.user.email : '' %></div>
                    </div>
                  </div>
                </td>
                <td class="fw-bold text-success">Rs. <%= tx.amount.toFixed(2) %></td>
                <td class="text-muted font-monospace small"><%= tx.transactionId %></td>
                <td>
                  <a href="<%= tx.screenshotPath %>" target="_blank" class="d-block">
                    <img src="<%= tx.screenshotPath %>" class="rounded border" style="height:48px;width:48px;object-fit:cover;cursor:zoom-in;">
                  </a>
                </td>
                <td class="text-muted small"><%= tx.createdAt.toLocaleString() %></td>
                <td class="text-end">
                  <div class="d-flex gap-2 justify-content-end">
                    <button class="btn btn-sm btn-success js-approve-btn d-inline-flex align-items-center gap-1.5" data-id="<%= tx._id %>">
                      <i class="fa-solid fa-check"></i> Approve
                    </button>
                    <button class="btn btn-sm btn-outline-danger js-reject-btn d-inline-flex align-items-center gap-1.5" data-id="<%= tx._id %>">
                      <i class="fa-solid fa-xmark"></i> Reject
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- History Tab -->
  <div class="tab-pane fade" id="historyTab" role="tabpanel">
    <div class="card shadow-sm border-0" style="border-radius: 16px; border: 1px solid #e2e8f0; overflow: hidden;">
      <div class="table-responsive">
        <table class="table table-modern align-middle mb-0">
          <thead>
            <tr>
              <th>User</th>
              <th>Amount</th>
              <th>TRX ID</th>
              <th>Status</th>
              <th>Note</th>
              <th>Reviewed</th>
            </tr>
          </thead>
          <tbody>
            <% if (history.length === 0) { %>
              <tr>
                <td colspan="6" class="text-center text-muted py-5">
                  <i class="fa-solid fa-folder-open fa-3x mb-3 opacity-25"></i>
                  <h6 class="fw-bold text-dark">No history available</h6>
                  <div>Reviewed payment requests will appear here.</div>
                </td>
              </tr>
            <% } %>
            <% history.forEach(tx => { %>
              <tr>
                <td class="fw-semibold text-dark"><%= tx.user ? tx.user.name : 'Deleted User' %></td>
                <td class="fw-bold">Rs. <%= tx.amount.toFixed(2) %></td>
                <td class="text-muted font-monospace small"><%= tx.transactionId %></td>
                <td>
                  <span class="badge <%= tx.status === 'approved' ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' %> px-3 py-2 rounded-pill text-capitalize">
                    <%= tx.status %>
                  </span>
                </td>
                <td class="text-muted small"><%= tx.adminNote || '-' %></td>
                <td class="text-muted small"><%= tx.reviewedAt ? tx.reviewedAt.toLocaleString() : '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.js-approve-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('Approve this payment and credit the user\'s balance?')) return;
      const id = btn.dataset.id;
      const originalHTML = btn.innerHTML;
      
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

      try {
        const res = await fetch(`/admin/payments/${id}/approve`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          const row = document.querySelector(`tr[data-tx-id="${id}"]`);
          if (row) row.style.transition = 'opacity 0.3s ease', row.style.opacity = '0', setTimeout(() => row.remove(), 300);
        } else {
          alert(data.error || 'Failed to approve.');
          btn.disabled = false;
          btn.innerHTML = originalHTML;
        }
      } catch (err) {
        alert('Network error while approving.');
        btn.disabled = false;
        btn.innerHTML = originalHTML;
      }
    });
  });

  document.querySelectorAll('.js-reject-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const reason = prompt('Reason for rejection:');
      if (reason === null) return;
      const id = btn.dataset.id;
      const originalHTML = btn.innerHTML;
      
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

      try {
        const res = await fetch(`/admin/payments/${id}/reject`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason }),
        });
        const data = await res.json();
        if (data.success) {
          const row = document.querySelector(`tr[data-tx-id="${id}"]`);
          if (row) row.style.transition = 'opacity 0.3s ease', row.style.opacity = '0', setTimeout(() => row.remove(), 300);
        } else {
          alert(data.error || 'Failed to reject.');
          btn.disabled = false;
          btn.innerHTML = originalHTML;
        }
      } catch (err) {
        alert('Network error while rejecting.');
        btn.disabled = false;
        btn.innerHTML = originalHTML;
      }
    });
  });
</script>
