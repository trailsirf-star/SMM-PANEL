<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Manage Services</h4>
</div>
<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover">
            <thead><tr><th>Category</th><th>Name</th><th>Provider Rate</th><th>Sell Rate</th><th>Min/Max</th><th>Status</th></tr></thead>
            <tbody>
                <% services.forEach(s => { %>
                    <tr>
                        <td><%= s.category %></td>
                        <td><%= s.name %></td>
                        <td><%= s.providerCostPer1000 %></td>
                        <td><%= s.sellPricePer1000 %></td>
                        <td><%= s.minOrder %> / <%= s.maxOrder %></td>
                        <td><span class="badge bg-<%= s.status === 'active' ? 'success' : 'danger' %>"><%= s.status %></span></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>