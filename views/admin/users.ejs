<h4 class="mb-4">Manage Users</h4>
<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover">
            <thead><tr><th>Name</th><th>Email</th><th>Balance</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                <% users.forEach(u => { %>
                    <tr>
                        <td><%= u.name %></td>
                        <td><%= u.email %></td>
                        <td><%= u.balance.toFixed(2) %></td>
                        <td><%= u.status %></td>
                        <td>
                            <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#balModal<%= u._id %>">Adjust Bal</button>
                            <form action="/admin/users/<%= u._id %>/ban" method="POST" class="d-inline">
                                <button class="btn btn-sm btn-warning"><%= u.status === 'active' ? 'Ban' : 'Unban' %></button>
                            </form>
                        </td>
                    </tr>
                    <div class="modal fade" id="balModal<%= u._id %>">
                        <div class="modal-dialog"><div class="modal-content">
                            <form action="/admin/users/<%= u._id %>/balance" method="POST">
                                <div class="modal-header"><h5>Adjust Balance for <%= u.name %></h5></div>
                                <div class="modal-body">
                                    <div class="mb-2">
                                        <label>Action</label>
                                        <select name="action" class="form-select"><option value="add">Add</option><option value="deduct">Deduct</option></select>
                                    </div>
                                    <div class="mb-2">
                                        <label>Amount</label>
                                        <input type="number" name="amount" step="0.01" class="form-control" required>
                                    </div>
                                </div>
                                <div class="modal-footer"><button class="btn btn-primary">Save</button></div>
                            </form>
                        </div></div>
                    </div>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>