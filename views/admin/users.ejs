<h3 class="fw-bold mb-4">Manage Users</h3>

<form method="GET" action="/admin/users" class="mb-3">
  <div class="input-group" style="max-width: 400px;">
    <input type="text" name="q" class="form-control" placeholder="Search by name or email" value="<%= q %>">
    <button class="btn btn-primary" type="submit">Search</button>
  </div>
</form>

<div class="card shadow-sm border-0">
  <div class="table-responsive">
    <table class="table mb-0 align-middle">
      <thead class="table-light">
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Balance</th>
          <th>Role</th>
          <th>Status</th>
          <th>Joined</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (users.length === 0) { %>
          <tr><td colspan="7" class="text-center text-muted py-4">No users found.</td></tr>
        <% } %>
        <% users.forEach(u => { %>
          <tr data-user-id="<%= u._id %>">
            <td><%= u.name %></td>
            <td><%= u.email %></td>
            <td class="js-balance">Rs. <%= u.balance.toFixed(2) %></td>
            <td><span class="badge bg-secondary"><%= u.role %></span></td>
            <td><span class="badge js-status-badge <%= u.status === 'banned' ? 'bg-danger' : 'bg-success' %>"><%= u.status %></span></td>
            <td><%= u.createdAt.toLocaleDateString() %></td>
            <td class="text-nowrap">
              <button class="btn btn-sm btn-outline-primary js-view-btn" data-id="<%= u._id %>">View</button>
              <button class="btn btn-sm btn-outline-secondary js-adjust-btn" data-id="<%= u._id %>">Adjust Balance</button>
              <button class="btn btn-sm <%= u.status === 'banned' ? 'btn-outline-success' : 'btn-outline-danger' %> js-ban-btn" data-id="<%= u._id %>">
                <%= u.status === 'banned' ? 'Unban' : 'Ban' %>
              </button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- View user modal -->
<div class="modal fade" id="userDetailModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">User Detail</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="userDetailBody">Loading...</div>
    </div>
  </div>
</div>

<script>
  const userDetailModal = new bootstrap.Modal(document.getElementById('userDetailModal'));

  document.querySelectorAll('.js-view-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.id;
      document.getElementById('userDetailBody').innerHTML = 'Loading...';
      userDetailModal.show();

      const res = await fetch(`/admin/users/${id}`);
      const data = await res.json();

      if (!data.success) {
        document.getElementById('userDetailBody').innerHTML = '<div class="alert alert-danger">Failed to load user.</div>';
        return;
      }

      const ordersRows = data.orders.map(o =>
        `<tr><td>${o.service ? o.service.name : '-'}</td><td>${o.quantity}</td><td>Rs. ${o.charge.toFixed(2)}</td><td>${o.status}</td></tr>`
      ).join('') || '<tr><td colspan="4" class="text-muted text-center">No orders</td></tr>';

      const txRows = data.transactions.map(t =>
        `<tr><td>Rs. ${t.amount.toFixed(2)}</td><td>${t.transactionId}</td><td>${t.status}</td></tr>`
      ).join('') || '<tr><td colspan="3" class="text-muted text-center">No transactions</td></tr>';

      document.getElementById('userDetailBody').innerHTML = `
        <p><strong>${data.user.name}</strong> — ${data.user.email}</p>
        <p>Balance: Rs. ${data.user.balance.toFixed(2)} | Status: ${data.user.status}</p>
        <h6 class="mt-3">Orders</h6>
        <table class="table table-sm"><thead><tr><th>Service</th><th>Qty</th><th>Charge</th><th>Status</th></tr></thead>
        <tbody>${ordersRows}</tbody></table>
        <h6 class="mt-3">Fund Requests</h6>
        <table class="table table-sm"><thead><tr><th>Amount</th><th>TRX ID</th><th>Status</th></tr></thead>
        <tbody>${txRows}</tbody></table>
      `;
    });
  });

  document.querySelectorAll('.js-adjust-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const amountStr = prompt('Enter amount to add (use negative number to deduct):');
      if (amountStr === null || amountStr.trim() === '') return;
      const reason = prompt('Reason for adjustment:') || '';
      const id = btn.dataset.id;

      const res = await fetch(`/admin/users/${id}/adjust-balance`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ amount: amountStr, reason }),
      });
      const data = await res.json();

      if (data.success) {
        document.querySelector(`tr[data-user-id="${id}"] .js-balance`).textContent = 'Rs. ' + data.balance.toFixed(2);
      } else {
        alert(data.error || 'Failed to adjust balance.');
      }
    });
  });

  document.querySelectorAll('.js-ban-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.id;
      if (!confirm('Are you sure you want to change this user\'s status?')) return;

      const res = await fetch(`/admin/users/${id}/toggle-ban`, { method: 'POST' });
      const data = await res.json();

      if (data.success) {
        window.location.reload();
      } else {
        alert(data.error || 'Failed to update status.');
      }
    });
  });
</script>
