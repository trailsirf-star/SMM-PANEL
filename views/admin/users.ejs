<div class="page-header mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
  <div>
    <h3 class="fw-bold mb-1">Manage Users</h3>
    <p class="text-muted mb-0">View user details, adjust balances, and manage account statuses.</p>
  </div>
  <form method="GET" action="/admin/users" class="w-100" style="max-width: 360px;">
    <div class="input-group">
      <span class="input-group-text bg-white border-end-0" style="border-radius: 8px 0 0 8px; border-color: #e2e8f0;">
        <i class="fa-solid fa-magnifying-glass text-muted"></i>
      </span>
      <input type="text" name="q" class="form-control border-start-0" placeholder="Search name or email..." value="<%= q %>" style="border-radius: 0 8px 8px 0; border-color: #e2e8f0; padding-left: 0;">
    </div>
  </form>
</div>

<div class="card shadow-sm border-0" style="border-radius: 16px; border: 1px solid #e2e8f0; overflow: hidden;">
  <div class="table-responsive">
    <table class="table table-modern align-middle mb-0">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Balance</th>
          <th>Role</th>
          <th>Status</th>
          <th>Joined</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody id="usersTableBody">
        <% if (users.length === 0) { %>
          <tr>
            <td colspan="7" class="text-center text-muted py-5">
              <i class="fa-solid fa-users-slash fa-3x mb-3 opacity-25"></i>
              <h6 class="fw-bold text-dark">No users found</h6>
              <div>Try searching for a different name or email.</div>
            </td>
          </tr>
        <% } %>
        <% users.forEach(u => { %>
          <tr data-user-id="<%= u._id %>">
            <td>
              <div class="d-flex align-items-center gap-2">
                <div class="admin-avatar" style="width: 32px; height: 32px; font-size: 0.8rem; background: linear-gradient(135deg, #64748b, #94a3b8);">
                  <%= u.name.charAt(0).toUpperCase() %>
                </div>
                <span class="fw-semibold text-dark"><%= u.name %></span>
              </div>
            </td>
            <td class="text-muted"><%= u.email %></td>
            <td class="js-balance fw-medium text-dark">Rs. <%= u.balance.toFixed(2) %></td>
            <td>
              <span class="badge bg-light text-dark text-capitalize border px-3 py-2 rounded-pill" style="font-size: 0.75rem;"><%= u.role %></span>
            </td>
            <td>
              <span class="badge js-status-badge text-capitalize px-3 py-2 rounded-pill <%= u.status === 'banned' ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success' %>" style="font-size: 0.75rem;">
                <%= u.status %>
              </span>
            </td>
            <td class="text-muted small"><%= u.createdAt.toLocaleDateString() %></td>
            <td class="text-end">
              <div class="d-flex gap-2 justify-content-end">
                <button class="btn btn-sm btn-light js-view-btn d-inline-flex align-items-center gap-1.5" data-id="<%= u._id %>" style="border: 1px solid #e2e8f0; color: #475569; font-weight: 500;">
                  <i class="fa-solid fa-eye"></i> View
                </button>
                <button class="btn btn-sm btn-light js-adjust-btn d-inline-flex align-items-center gap-1.5" data-id="<%= u._id %>" style="border: 1px solid #e2e8f0; color: #475569; font-weight: 500;">
                  <i class="fa-solid fa-wallet"></i> Balance
                </button>
                <% if (u.status === 'banned') { %>
                  <button class="btn btn-sm btn-light js-ban-btn d-inline-flex align-items-center gap-1.5" data-id="<%= u._id %>" style="border: 1px solid #d1fae5; color: #059669; font-weight: 500;">
                    <i class="fa-solid fa-unlock"></i> Unban
                  </button>
                <% } else { %>
                  <button class="btn btn-sm btn-light js-ban-btn d-inline-flex align-items-center gap-1.5" data-id="<%= u._id %>" style="border: 1px solid #fecaca; color: #dc2626; font-weight: 500;">
                    <i class="fa-solid fa-ban"></i> Ban
                  </button>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- View user modal -->
<div class="modal fade" id="userDetailModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold">User Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4" id="userDetailBody">
        <div class="text-center py-5">
          <div class="spinner-border text-primary" role="status"></div>
          <p class="mt-3 text-muted">Loading user data...</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const userDetailModal = new bootstrap.Modal(document.getElementById('userDetailModal'));

  // Event delegation (instead of per-button listeners) so View/Balance/Ban still
  // work on rows injected later by auto-refresh polling.
  document.addEventListener('click', async (e) => {
    const viewBtn = e.target.closest('.js-view-btn');
    if (viewBtn) return handleViewUser(viewBtn);

    const adjustBtn = e.target.closest('.js-adjust-btn');
    if (adjustBtn) return handleAdjustBalance(adjustBtn);

    const banBtn = e.target.closest('.js-ban-btn');
    if (banBtn) return handleToggleBan(banBtn);
  });

  async function handleViewUser(btn) {
    const id = btn.dataset.id;
    const originalHTML = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

    document.getElementById('userDetailBody').innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-3 text-muted">Loading...</p></div>';
    userDetailModal.show();

    try {
      const res = await fetch(`/admin/users/${id}`);
      const data = await res.json();

      if (!data.success) {
        document.getElementById('userDetailBody').innerHTML = '<div class="alert alert-danger">Failed to load user.</div>';
        return;
      }

      const ordersRows = data.orders.map(o =>
        `<tr><td class="text-muted">${o.service ? o.service.name : '-'}</td><td>${o.quantity}</td><td class="fw-medium">Rs. ${o.charge.toFixed(2)}</td><td><span class="badge bg-light text-dark text-capitalize">${o.status}</span></td></tr>`
      ).join('') || '<tr><td colspan="4" class="text-muted text-center py-3">No orders found</td></tr>';

      const txRows = data.transactions.map(t =>
        `<tr><td class="fw-medium text-success">Rs. ${t.amount.toFixed(2)}</td><td class="text-muted font-monospace small">${t.transactionId || '-'}</td><td><span class="badge ${t.status === 'approved' ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger'} text-capitalize">${t.status}</span></td></tr>`
      ).join('') || '<tr><td colspan="3" class="text-muted text-center py-3">No transactions found</td></tr>';

      document.getElementById('userDetailBody').innerHTML = `
        <div class="d-flex align-items-center gap-3 mb-4 p-3 bg-light" style="border-radius: 12px;">
          <div class="admin-avatar" style="width: 48px; height: 48px; font-size: 1.2rem; background: linear-gradient(135deg, #4f46e5, #818cf8);">
            ${data.user.name.charAt(0).toUpperCase()}
          </div>
          <div>
            <h5 class="mb-0 fw-bold">${data.user.name}</h5>
            <div class="text-muted small">${data.user.email}</div>
          </div>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-6">
            <div class="card border" style="border-radius: 10px !important;">
              <div class="card-body p-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Balance</div>
                <div class="fs-5 fw-bold text-dark">Rs. ${data.user.balance.toFixed(2)}</div>
              </div>
            </div>
          </div>
          <div class="col-6">
            <div class="card border" style="border-radius: 10px !important;">
              <div class="card-body p-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Status</div>
                <div class="fs-5 fw-bold text-capitalize ${data.user.status === 'banned' ? 'text-danger' : 'text-success'}">${data.user.status}</div>
              </div>
            </div>
          </div>
        </div>

        <h6 class="fw-bold mb-2 mt-4">Recent Orders</h6>
        <div class="table-responsive mb-4">
          <table class="table table-sm table-modern">
            <thead><tr><th>Service</th><th>Qty</th><th>Charge</th><th>Status</th></tr></thead>
            <tbody>${ordersRows}</tbody>
          </table>
        </div>

        <h6 class="fw-bold mb-2">Fund Requests</h6>
        <div class="table-responsive">
          <table class="table table-sm table-modern">
            <thead><tr><th>Amount</th><th>TRX ID</th><th>Status</th></tr></thead>
            <tbody>${txRows}</tbody>
          </table>
        </div>
      `;
    } catch (err) {
      document.getElementById('userDetailBody').innerHTML = '<div class="alert alert-danger">Network error loading user.</div>';
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalHTML;
    }
  }

  async function handleAdjustBalance(btn) {
    const amountStr = prompt('Enter amount to add (use negative number to deduct):');
    if (amountStr === null || amountStr.trim() === '') return;
    const reason = prompt('Reason for adjustment:') || '';
    const id = btn.dataset.id;
    const originalHTML = btn.innerHTML;

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

    try {
      const res = await fetch(`/admin/users/${id}/adjust-balance`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ amount: amountStr, reason }),
      });
      const data = await res.json();

      if (data.success) {
        const cell = document.querySelector(`tr[data-user-id="${id}"] .js-balance`);
        if (cell) cell.textContent = 'Rs. ' + data.balance.toFixed(2);
      } else {
        alert(data.error || 'Failed to adjust balance.');
      }
    } catch (err) {
      alert('Network error adjusting balance.');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalHTML;
    }
  }

  async function handleToggleBan(btn) {
    const id = btn.dataset.id;
    if (!confirm('Are you sure you want to change this user\'s status?')) return;
    const originalHTML = btn.innerHTML;

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

    try {
      const res = await fetch(`/admin/users/${id}/toggle-ban`, { method: 'POST' });
      const data = await res.json();

      if (data.success) {
        // Patch this row in place instead of a full page reload.
        const row = document.querySelector(`tr[data-user-id="${id}"]`);
        const badge = row ? row.querySelector('.js-status-badge') : null;
        const isBanned = data.status === 'banned';

        if (badge) {
          badge.textContent = data.status;
          badge.classList.toggle('bg-danger-subtle', isBanned);
          badge.classList.toggle('text-danger', isBanned);
          badge.classList.toggle('bg-success-subtle', !isBanned);
          badge.classList.toggle('text-success', !isBanned);
        }

        btn.dataset.id = id;
        btn.style.borderColor = isBanned ? '#d1fae5' : '#fecaca';
        btn.style.color = isBanned ? '#059669' : '#dc2626';
        btn.innerHTML = isBanned
          ? '<i class="fa-solid fa-unlock"></i> Unban'
          : '<i class="fa-solid fa-ban"></i> Ban';
        btn.disabled = false;
      } else {
        alert(data.error || 'Failed to update status.');
        btn.disabled = false;
        btn.innerHTML = originalHTML;
      }
    } catch (err) {
      alert('Network error updating status.');
      btn.disabled = false;
      btn.innerHTML = originalHTML;
    }
  }

  // ---------- Lightweight auto-refresh ----------
  // Periodically re-fetches this same page (keeping the current search query)
  // in the background and swaps in the fresh table rows, so new users and
  // updated balances show up without a manual browser reload.
  let usersPollInFlight = false;

  async function pollUsers() {
    if (usersPollInFlight || document.hidden) return;
    usersPollInFlight = true;
    try {
      const res = await fetch(window.location.pathname + window.location.search, { headers: { 'X-Requested-With': 'poll' } });
      if (!res.ok) return;
      const html = await res.text();
      const doc = new DOMParser().parseFromString(html, 'text/html');

      const freshBody = doc.getElementById('usersTableBody');
      const body = document.getElementById('usersTableBody');
      if (freshBody && body) body.innerHTML = freshBody.innerHTML;
    } catch (err) {
      // Silent — a failed background poll shouldn't interrupt the admin.
    } finally {
      usersPollInFlight = false;
    }
  }

  setInterval(pollUsers, 8000);
</script>
