<div class="card shadow-sm">
    <div class="card-body p-4">
        <h4 class="mb-4">Site Settings</h4>
        <form action="/admin/settings" method="POST">
            <div class="row">
                <div class="col-md-6 mb-3"><label>Site Name</label><input type="text" name="siteName" value="<%= settings.siteName %>" class="form-control"></div>
                <div class="col-md-6 mb-3"><label>Currency</label><input type="text" name="currency" value="<%= settings.currency %>" class="form-control"></div>
                <div class="col-md-6 mb-3"><label>Easypaisa Number</label><input type="text" name="easypaisaNumber" value="<%= settings.easypaisaNumber %>" class="form-control"></div>
                <div class="col-md-6 mb-3"><label>Easypaisa Account Name</label><input type="text" name="easypaisaAccountName" value="<%= settings.easypaisaAccountName %>" class="form-control"></div>
                <div class="col-md-6 mb-3"><label>WhatsApp Number</label><input type="text" name="whatsappNumber" value="<%= settings.whatsappNumber %>" class="form-control"></div>
                <div class="col-md-6 mb-3"><label>Minimum Deposit</label><input type="number" name="minimumDeposit" value="<%= settings.minimumDeposit %>" class="form-control"></div>
            </div>
            <button type="submit" class="btn btn-primary">Save Settings</button>
        </form>
    </div>
</div>