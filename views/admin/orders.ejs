<h3 class="fw-bold mb-4">Manage Orders</h3>

<div class="card shadow-sm border-0 mb-4">
  <div class="card-body">
    <form method="GET" action="/admin/orders" class="row g-2">
      <div class="col-md-3">
        <select name="status" class="form-select">
          <option value="">All Statuses</option>
          <% ['pending','processing','in progress','completed','partial','cancelled','refunded'].forEach(s => { %>
            <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <select name="serviceId" class="form-select">
          <option value="">All Services</option>
          <% services.forEach(s => { %>
            <option value="<%= s._id %>" <%= filters.serviceId === String(s._id) ? 'selected' : '' %>><%= s.category %> - <%= s.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <input type="date" name="date" class="form-control" value="<%= filters.date %>">
      </div>
      <div class="col-md-3">
        <input type="text" name="userQuery" class="form-control" placeholder="Search by user name/email" value="<%= filters.userQuery %>">
      </div>
      <div class="col-md-1">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
      </div>
    </form>
  </div>
</div>

<div class="card shadow-sm border-0">
  <div class="table-responsive">
    <table class="table mb-0 align-middle">
      <thead class="table-light">
        <tr>
          <th>Order ID</th>
          <th>User</th>
          <th>Service</th>
          <th>Qty</th>
          <th>Charge</th>
          <th>Remains</th>
          <th>Status</th>
          <th>Date</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (orders.length === 0) { %>
          <tr><td colspan="9" class="text-center text-muted py-4">No orders found.</td></tr>
        <% } %>
        <% orders.forEach(order => { %>
          <tr data-order-id="<%= order._id %>">
            <td class="text-muted small">#<%= order._id.toString().slice(-6) %></td>
            <td><%= order.user ? order.user.name : 'Deleted User' %><div class="small text-muted"><%= order.user ? order.user.email : '' %></div></td>
            <td><%= order.service ? order.service.name : 'Deleted Service' %></td>
            <td><%= order.quantity %></td>
            <td>Rs. <%= order.charge.toFixed(2) %></td>
            <td class="js-remains"><%= order.remains %></td>
            <td><span class="badge status-badge js-status status-<%= order.status.replace(' ', '-') %>"><%= order.status %></span></td>
            <td><%= order.createdAt.toLocaleString() %></td>
            <td>
              <button class="btn btn-sm btn-outline-secondary js-refresh-btn" data-id="<%= order._id %>">
                <i class="fa-solid fa-rotate"></i> Refresh
              </button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script>
  document.querySelectorAll('.js-refresh-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.id;
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

      try {
        const res = await fetch(`/admin/orders/${id}/refresh`, { method: 'POST' });
        const data = await res.json();

        if (data.success) {
          const row = document.querySelector(`tr[data-order-id="${id}"]`);
          row.querySelector('.js-status').textContent = data.order.status;
          row.querySelector('.js-status').className = 'badge status-badge js-status status-' + data.order.status.replace(' ', '-');
          row.querySelector('.js-remains').textContent = data.order.remains;
        } else {
          alert(data.error || 'Failed to refresh order.');
        }
      } catch (err) {
        alert('Network error while refreshing order.');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-rotate"></i> Refresh';
      }
    });
  });
</script>
