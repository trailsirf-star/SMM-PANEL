<div class="card shadow-sm">
    <div class="card-body">
        <h4 class="mb-4">All Orders</h4>
        <table class="table table-hover">
            <thead><tr><th>User</th><th>Service</th><th>Link</th><th>Qty</th><th>Charge</th><th>Status</th></tr></thead>
            <tbody>
                <% orders.forEach(o => { %>
                    <tr>
                        <td><%= o.user ? o.user.name : 'N/A' %></td>
                        <td><%= o.service ? o.service.name : 'N/A' %></td>
                        <td><a href="<%= o.link %>" target="_blank" class="text-truncate d-inline-block" style="max-width: 120px;"><%= o.link %></a></td>
                        <td><%= o.quantity %></td>
                        <td><%= o.charge.toFixed(2) %></td>
                        <td><span class="badge bg-info"><%= o.status %></span></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>