<div class="page-header mb-4">
  <h3 class="fw-bold mb-1">Manage Orders</h3>
  <p class="text-muted mb-0">Search, filter, and monitor all user orders.</p>
</div>

<!-- Filters -->
<div class="card shadow-sm border-0 mb-4" style="border-radius: 16px; border: 1px solid #e2e8f0;">
  <div class="card-body p-3 p-md-4">
    <form method="GET" action="/admin/orders" class="row g-3 align-items-end">
      <div class="col-md-3">
        <label class="form-label">Status</label>
        <select name="status" class="form-select">
          <option value="">All Statuses</option>
          <% ['pending','processing','in progress','completed','partial','cancelled','refunded'].forEach(s => { %>
            <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label">Service</label>
        <select name="serviceId" class="form-select">
          <option value="">All Services</option>
          <% services.forEach(s => { %>
            <option value="<%= s._id %>" <%= filters.serviceId === String(s._id) ? 'selected' : '' %>><%= s.category %> - <%= s.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label">Date</label>
        <input type="date" name="date" class="form-control" value="<%= filters.date %>">
      </div>
      <div class="col-md-3">
        <label class="form-label">User Search</label>
        <input type="text" name="userQuery" class="form-control" placeholder="Name or email" value="<%= filters.userQuery %>">
      </div>
      <div class="col-md-1">
        <button type="submit" class="btn btn-primary w-100 py-2.5">
          <i class="fa-solid fa-filter"></i>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Orders Table -->
<div class="card shadow-sm border-0" style="border-radius: 16px; border: 1px solid #e2e8f0; overflow: hidden;">
  <div class="table-responsive">
    <table class="table table-modern align-middle mb-0">
      <thead>
        <tr>
          <th>Order ID</th>
          <th>User</th>
          <th>Service</th>
          <th>Qty</th>
          <th>Charge</th>
          <th>Remains</th>
          <th>Status</th>
          <th>Date</th>
          <th class="text-end">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (orders.length === 0) { %>
          <tr>
            <td colspan="9" class="text-center text-muted py-5">
              <i class="fa-solid fa-box-open fa-3x mb-3 opacity-25"></i>
              <h6 class="fw-bold text-dark">No orders found</h6>
              <div>Try adjusting your filters or search terms.</div>
            </td>
          </tr>
        <% } %>
        <% orders.forEach(order => { %>
          <tr data-order-id="<%= order._id %>">
            <td class="text-muted small fw-medium">#<%= order._id.toString().slice(-6) %></td>
            <td>
              <div class="fw-semibold text-dark"><%= order.user ? order.user.name : 'Deleted User' %></div>
              <div class="small text-muted"><%= order.user ? order.user.email : '' %></div>
            </td>
            <td class="text-muted"><%= order.service ? order.service.name : 'Deleted Service' %></td>
            <td class="fw-medium"><%= order.quantity %></td>
            <td class="fw-semibold text-dark">Rs. <%= order.charge.toFixed(2) %></td>
            <td class="js-remains text-muted"><%= order.remains %></td>
            <td><span class="badge status-badge js-status status-<%= order.status.replace(' ', '-') %>"><%= order.status %></span></td>
            <td class="text-muted small"><%= order.createdAt.toLocaleString() %></td>
            <td class="text-end">
              <button class="btn btn-sm btn-light js-refresh-btn d-inline-flex align-items-center gap-1.5" data-id="<%= order._id %>" style="border: 1px solid #e2e8f0; color: #475569; font-weight: 500;">
                <i class="fa-solid fa-rotate"></i> Refresh
              </button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script>
  document.querySelectorAll('.js-refresh-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.id;
      const originalHTML = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

      try {
        const res = await fetch(`/admin/orders/${id}/refresh`, { method: 'POST' });
        const data = await res.json();

        if (data.success) {
          const row = document.querySelector(`tr[data-order-id="${id}"]`);
          row.querySelector('.js-status').textContent = data.order.status;
          row.querySelector('.js-status').className = 'badge status-badge js-status status-' + data.order.status.replace(' ', '-');
          row.querySelector('.js-remains').textContent = data.order.remains;
        } else {
          alert(data.error || 'Failed to refresh order.');
        }
      } catch (err) {
        alert('Network error while refreshing order.');
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalHTML;
      }
    });
  });
</script>
