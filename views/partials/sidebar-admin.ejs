<aside class="admin-sidebar">
  <div class="sidebar-brand">
    <div class="brand-icon"><i class="fa-solid fa-bolt"></i></div>
    <span class="brand-text">MRFSMM</span>
  </div>

  <ul class="nav flex-column">
    <li class="nav-item">
      <div class="nav-label">Main Menu</div>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= currentPath === '/admin/dashboard' ? 'active-link' : '' %>" href="/admin/dashboard">
        <i class="fa-solid fa-gauge"></i> <span>Dashboard</span>
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= currentPath === '/admin/orders' ? 'active-link' : '' %>" href="/admin/orders">
        <i class="fa-solid fa-list-check"></i> <span>Orders</span>
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= currentPath === '/admin/payments' ? 'active-link' : '' %>" href="/admin/payments">
        <i class="fa-solid fa-money-check-dollar"></i> <span>Payments</span>
      </a>
    </li>

    <li class="nav-item">
      <div class="nav-label">Management</div>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= currentPath === '/admin/users' ? 'active-link' : '' %>" href="/admin/users">
        <i class="fa-solid fa-users"></i> <span>Users</span>
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= currentPath === '/admin/services' ? 'active-link' : '' %>" href="/admin/services">
        <i class="fa-solid fa-cubes"></i> <span>Services</span>
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= currentPath === '/admin/api-providers' ? 'active-link' : '' %>" href="/admin/api-providers">
        <i class="fa-solid fa-plug"></i> <span>API Providers</span>
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= currentPath === '/admin/settings' ? 'active-link' : '' %>" href="/admin/settings">
        <i class="fa-solid fa-gear"></i> <span>Settings</span>
      </a>
    </li>
  </ul>
  
  <div class="sidebar-footer">
     <div class="d-flex align-items-center gap-2">
       <div class="admin-avatar" style="width: 32px; height: 32px; font-size: 0.8rem;"><%= user.name.charAt(0).toUpperCase() %></div>
       <div class="d-flex flex-column text-white lh-sm" style="font-size: 0.85rem;">
         <span class="fw-bold"><%= user.name %></span>
         <a href="/logout" class="text-muted" style="font-size: 0.75rem;">Sign out</a>
       </div>
     </div>
  </div>
</aside>
